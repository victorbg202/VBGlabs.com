---
interface Props {
  label: string;
}

const { label } = Astro.props;
---
<span class="pending">{label}</span>

<style>
  .pending {
    background: var(--warn-wash);
    color: var(--warn);
    font-weight: 600;
    font-size: 0.85em;
    padding: 0.1em 0.5em;
    border-radius: 4px;
  }
</style>
