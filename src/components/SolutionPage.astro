---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ContactForm from '@/components/ContactForm.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import SolutionCatalog from '@/components/SolutionCatalog.astro';
import ServiceSchema from '@/components/schema/ServiceSchema.astro';
import { DEFINITIONS, solutionContent, solutionPath, solutionAlternates, type SolutionId } from '@/data/solutions/catalog';
import { SOLUTION_UI } from '@/data/solutions/ui';
import { SOLUTION_PRICING, formatPriceBand } from '@/data/pricing';
import { route } from '@/i18n/routes';
import type { Locale } from '@/i18n/locales';
interface Props {id: SolutionId; locale: Locale;}
const {id,locale} = Astro.props;
const item = solutionContent(id,locale);
const definition = DEFINITIONS[id];
const ui = SOLUTION_UI[locale];
const path = solutionPath(id,locale);
const band = definition.price ? SOLUTION_PRICING[definition.price] : null;
const guides = (await getCollection('blog',post => post.data.lang===locale && !post.data.draft && definition.guides.includes(post.data.translationGroup))).slice(0,2);
---
<BaseLayout locale={locale} routeKey="services" title={item.title} description={item.description} path={path} alternates={solutionAlternates(id)}>
  <div class="solution-page" data-solution={id}>
    <section class="hero solution-hero">
      <div class="container">
        <Breadcrumb locale={locale} trail={[{name:ui.services,path:route('services',locale)},{name:item.name,path}]} />
        <div class="solution-hero__grid">
          <div class="solution-hero__copy">
            <p class="eyebrow">{definition.kind==='sector' ? ui.sectors : ui.tailored}</p>
            <h1>{item.h1}</h1>
            <p class="lede">{item.lead}</p>
            <div class="solution-actions">
              <a class="btn btn-primary" href="#parlem">{ui.cta}</a>
              <a class="example-link" href="#exemple">{ui.how}<span aria-hidden="true"> ↓</span></a>
            </div>
            <p class="location">{ui.local}</p>
          </div>
          <aside class="project-card" aria-label={band ? ui.estimate : ui.sectorEstimate}>
            <p class="project-card__label">{band ? ui.estimate : ui.sectorEstimate}</p>
            <p class:list={['project-card__price',{'project-card__price--text':!band}]}>{band ? formatPriceBand(band,locale) : ui.sectorPrice}</p>
            <p>{item.priceScope}</p>
            <hr />
            <p class="project-card__note">{ui.recurringShort}</p>
            <a href="#inversio">{ui.pricing}<span aria-hidden="true"> ↓</span></a>
          </aside>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>{ui.pains}</h2>
        <ul class="pain-grid">{item.pains.map((pain,i)=><li><span class="number" aria-hidden="true">0{i+1}</span><p>{pain}</p></li>)}</ul>
      </div>
    </section>

    <section class="section tint">
      <div class="container">
        <h2>{ui.deliverables}</h2>
        <div class="detail-grid">{item.deliverables.map(part=><article class="detail-card"><h3>{part.title}</h3><p>{part.text}</p></article>)}</div>
      </div>
    </section>

    <section class="section" id="exemple">
      <div class="container">
        <p class="eyebrow">{ui.example}</p>
        <h2>{item.example.title}</h2>
        <ol class="flow">{item.example.steps.map((step,i)=><li><span class="flow__label">{ui.flowLabels[i]}</span><p>{step}</p></li>)}</ol>
        <p class="illustration-note">{ui.illustration}</p>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container scope-grid">
        <div class="scope-box"><h2>{ui.prepare}</h2><ul>{item.requirements.map(requirement=><li>{requirement}</li>)}</ul></div>
        <div class="scope-box scope-box--soft"><h2>{ui.boundaries}</h2><p>{item.boundary}</p></div>
      </div>
    </section>

    <section class="section tint" id="inversio">
      <div class="container">
        <h2>{ui.pricing}</h2>
        <div class="commercial-grid">
          <div class="implementation">
            <h3>{band ? ui.implementation : ui.sectorPrice}</h3>
            {band && <p class="investment">{formatPriceBand(band,locale)}</p>}
            <p>{item.priceScope}</p><p>{band ? ui.estimateNote : ui.sectorPricing}</p>
          </div>
          <div class="commercial-details"><article><h3>{ui.externalTitle}</h3><p>{ui.external}</p></article><article><h3>{ui.supportTitle}</h3><p>{ui.support}</p></article></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container"><h2>{ui.method}</h2><ol class="method-grid">{ui.steps.map((step,i)=><li><span class="number" aria-hidden="true">0{i+1}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div>
    </section>

    <section class="section section--tight">
      <div class="container"><div class="proof"><div><p class="eyebrow">VBG LABS</p><h2>{ui.proofTitle}</h2><p>{ui.proof}</p></div><div class="proof__links"><a class="btn btn-outline" href={route('invoicing',locale)}>{ui.proofCta}</a><a href={route('about',locale)}>{ui.about}</a></div></div></div>
    </section>

    <section class="section"><div class="container faq-wrap"><h2>{ui.faq}</h2><FaqAccordion items={[...item.faqs,...ui.commonFaqs]} /></div></section>
    <SolutionCatalog locale={locale} ids={definition.related} heading={ui.related} lede="" />
    {guides.length>0 && <section class="section section--tight"><div class="container"><h2>{ui.guides}</h2><ul class="guide-list">{guides.map(post=><li><a href={`${route('blog',locale)}${post.data.slug}/`}>{post.data.title}</a><p>{post.data.description}</p></li>)}</ul></div></section>}

    <section class="section contact-section" id="parlem">
      <div class="container contact-grid">
        <div><p class="eyebrow">{ui.context}</p><p class="context-label">{item.name}</p><h2>{ui.contactTitle}</h2><p class="lede">{ui.contactBody}</p><p class="contact-note">{ui.noSensitive}</p></div>
        <div class="form-card"><ContactForm locale={locale} id={`enquiry-${id}`} compact interest={id} contextLabel={item.name} sourcePath={path} sector={definition.kind==='sector'?id:''} messagePlaceholder={item.messagePrompt} /></div>
      </div>
    </section>
  </div>
  <ServiceSchema name={item.name} description={item.description} path={path} />
</BaseLayout>

<style>
  .solution-page section[id] {scroll-margin-top:100px;}
  .solution-page h2 {font-size:var(--text-2xl);max-width:30ch;margin-bottom:var(--space-4);text-wrap:balance;overflow-wrap:break-word;}
  .solution-page h3 {font-size:var(--text-lg);margin-bottom:var(--space-2);line-height:1.35;overflow-wrap:break-word;}
  .solution-hero {padding-block:var(--space-3) var(--space-7);background:var(--paper);}
  .solution-hero__grid {display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-5);align-items:start;margin-top:var(--space-3);}
  .solution-hero__grid > * {min-width:0;}
  .solution-hero h1 {font-size:clamp(2rem,1.4rem + 3vw,3.35rem);line-height:1.12;letter-spacing:-.025em;max-width:26ch;margin-block:var(--space-2) var(--space-3);overflow-wrap:break-word;text-wrap:balance;}
  .solution-hero .lede {max-width:57ch;font-size:var(--text-md);}
  .solution-actions {display:flex;flex-wrap:wrap;align-items:center;gap:var(--space-3);margin-top:var(--space-4);}
  .example-link {font-weight:600;font-size:var(--text-sm);color:var(--ink);}
  .location {font-size:var(--text-xs);color:var(--muted);margin-top:var(--space-3);}
  .project-card {padding:var(--space-4);border:1px solid var(--line);border-top:4px solid var(--red);border-radius:var(--radius-md);background:var(--white);box-shadow:var(--shadow-sm);}
  .project-card__label {text-transform:uppercase;letter-spacing:.06em;font-size:var(--text-xs);font-weight:700;color:var(--muted);}
  .project-card .project-card__price {font-size:clamp(1.2rem,1.1rem + .7vw,1.7rem);font-weight:700;color:var(--ink);line-height:1.3;margin-block:var(--space-2) var(--space-3);}
  .project-card .project-card__price--text {max-width:15ch;}
  .project-card p {font-size:var(--text-sm);}
  .project-card hr {border:0;border-top:1px solid var(--line);margin-block:var(--space-3);}
  .project-card .project-card__note {font-weight:600;}
  .project-card a {display:inline-block;color:var(--red);font-size:var(--text-sm);margin-top:var(--space-3);}
  .pain-grid,.method-grid {list-style:none;display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);padding:0;margin:0;}
  .pain-grid li,.method-grid li {min-width:0;}
  .number {display:block;color:var(--red);font-family:var(--font-heading);font-size:var(--text-sm);font-weight:700;margin-bottom:var(--space-2);}
  .pain-grid p,.method-grid p {color:var(--ink-soft);}
  .tint {background:var(--gray-50);}
  .detail-grid {display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-3);}
  .detail-card {background:var(--white);border:1px solid var(--line);border-radius:var(--radius-md);padding:var(--space-4);min-width:0;}
  .detail-card p {font-size:var(--text-sm);}
  .flow {list-style:none;display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-3);padding:0;margin:var(--space-4) 0 var(--space-3);}
  .flow li {min-width:0;border-left:3px solid var(--red);background:var(--red-50);padding:var(--space-4);border-radius:0 var(--radius-md) var(--radius-md) 0;}
  .flow__label {display:block;font-weight:700;font-size:var(--text-xs);letter-spacing:.06em;text-transform:uppercase;margin-bottom:var(--space-2);color:var(--red);}
  .flow p {font-size:var(--text-sm);}
  .illustration-note {font-size:var(--text-xs);color:var(--muted);}
  .scope-grid,.commercial-grid {display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);}
  .scope-box {border:1px solid var(--line);padding:var(--space-4);border-radius:var(--radius-md);min-width:0;}
  .scope-box--soft {background:var(--paper);}
  .scope-box h2 {font-size:var(--text-xl);}
  .scope-box ul {padding-left:1.2rem;}
  .scope-box li+li {margin-top:var(--space-2);}
  .scope-box p,.scope-box li {font-size:var(--text-sm);}
  .implementation,.commercial-details {min-width:0;}
  .investment {font-size:var(--text-xl);font-weight:700;color:var(--ink);margin-bottom:var(--space-3);}
  .implementation p,.commercial-details p {font-size:var(--text-sm);}
  .implementation p+p {margin-top:var(--space-3);}
  .commercial-details article+article {margin-top:var(--space-4);}
  .proof {border:1px solid var(--line);border-radius:var(--radius-lg);padding:var(--space-5);display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);background:var(--paper);}
  .proof h2 {font-size:var(--text-xl);margin-block:var(--space-2);}
  .proof p {font-size:var(--text-sm);}
  .proof__links {display:flex;align-items:flex-start;flex-direction:column;justify-content:center;gap:var(--space-3);min-width:0;}
  .proof__links>a:not(.btn) {font-size:var(--text-sm);color:var(--ink-soft);}
  .faq-wrap {max-width:940px;}
  .guide-list {list-style:none;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-4);}
  .guide-list li {border-top:1px solid var(--line);padding-top:var(--space-3);min-width:0;}
  .guide-list a {color:var(--ink);font-weight:600;}
  .guide-list p {font-size:var(--text-sm);margin-top:var(--space-2);}
  .contact-section {background:var(--red-50);}
  .contact-grid {display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-5);align-items:start;}
  .contact-grid>* {min-width:0;}
  .context-label {font-weight:600;font-size:var(--text-sm);margin-block:var(--space-2) var(--space-3);}
  .contact-grid h2 {max-width:18ch;}
  .contact-note {font-size:var(--text-sm);margin-top:var(--space-4);max-width:48ch;}
  .form-card {background:var(--white);border:1px solid var(--line);border-radius:var(--radius-md);padding:var(--space-4);}
  @media(min-width:760px){.pain-grid,.method-grid,.detail-grid,.flow{grid-template-columns:repeat(3,minmax(0,1fr));}.scope-grid,.commercial-grid,.guide-list{grid-template-columns:repeat(2,minmax(0,1fr));}.proof{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);}}
  @media(min-width:980px){.solution-hero__grid{grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:var(--space-6);}.contact-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-7);}}
</style>
