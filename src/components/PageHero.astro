---
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  lede: string;
  crumb: { name: string; path: string };
  dark?: boolean;
}

const { locale, eyebrow, title, lede, crumb, dark = false } = Astro.props;
---
<section class={`page-hero ${dark ? 'page-hero--dark' : ''}`}>
  <div class="container">
    <Breadcrumb locale={locale} trail={[crumb]} />
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>
</section>

<style>
  .page-hero {
    padding-block: var(--space-4) var(--space-6);
    background: var(--paper);
  }

  .page-hero--dark {
    background: var(--ink);
    color: var(--gray-300);
  }

  .page-hero--dark :global(.breadcrumb a),
  .page-hero--dark :global(.breadcrumb span) {
    color: var(--gray-400);
  }

  .page-hero h1 {
    font-size: var(--text-3xl);
    max-width: 18ch;
    margin-block: var(--space-2);
  }

  .page-hero--dark h1 {
    color: var(--white);
  }

  .page-hero .lede {
    font-size: var(--text-md);
    max-width: 56ch;
  }

  .page-hero .eyebrow,
  .page-hero h1,
  .page-hero .lede {
    opacity: 0;
    animation: hero-rise 0.6s var(--ease) forwards;
  }

  .page-hero .eyebrow {
    animation-delay: 0.05s;
  }

  .page-hero h1 {
    animation-delay: 0.14s;
  }

  .page-hero .lede {
    animation-delay: 0.24s;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero .eyebrow,
    .page-hero h1,
    .page-hero .lede {
      animation: none;
      opacity: 1;
    }
  }
</style>
