---
interface Props {
  before: string;
  after: string;
  beforeLabel: string;
  afterLabel: string;
}

const { before, after, beforeLabel, afterLabel } = Astro.props;
---
<div class="ba-row">
  <div class="ba-card ba-card--before" data-reveal style="--i:0">
    <span class="ba-tag">{beforeLabel}</span>
    <p>{before}</p>
  </div>
  <div class="ba-card ba-card--after" data-reveal style="--i:2">
    <span class="ba-tag">{afterLabel}</span>
    <p>{after}</p>
  </div>
</div>

<style>
  .ba-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  @media (min-width: 720px) {
    .ba-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ba-card {
    background: var(--white);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ba-card--after {
    background: var(--ok-wash);
  }

  .ba-tag {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: fit-content;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill);
  }

  .ba-card--before .ba-tag {
    color: var(--gray-600);
    background: var(--gray-100);
  }

  .ba-card--after .ba-tag {
    color: var(--teal-700);
    background: var(--white);
  }

  .ba-card p {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
</style>
