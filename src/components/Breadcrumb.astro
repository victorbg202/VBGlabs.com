---
import BreadcrumbSchema from '@/components/schema/BreadcrumbSchema.astro';
import { route } from '@/i18n/routes';
import type { Locale } from '@/i18n/locales';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  locale: Locale;
  trail: Crumb[]; // does not include home; home is prepended automatically
}

const { locale, trail } = Astro.props;
const homeLabel = locale === 'ca' ? 'Inici' : locale === 'es' ? 'Inicio' : 'Home';
const items = [{ name: homeLabel, path: route('home', locale) }, ...trail];
---
<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.path}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<BreadcrumbSchema items={items} />

<style>
  .breadcrumb {
    padding-block: var(--space-3);
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5em;
    color: var(--gray-300);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--red);
    text-decoration: underline;
  }

  .breadcrumb [aria-current='page'] {
    color: var(--ink-soft);
    font-weight: 500;
  }
</style>
