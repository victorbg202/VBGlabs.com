---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import BlogCard from '@/components/BlogCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import ArticleSchema from '@/components/schema/ArticleSchema.astro';
import { route } from '@/i18n/routes';
import type { Locale } from '@/i18n/locales';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'blog'>;
  alternates: { locale: Locale; path: string }[];
  related: CollectionEntry<'blog'>[];
  ctaTitle: string;
  ctaLede: string;
  ctaLabel: string;
  readLabel: string;
  relatedTitle: string;
}

const { locale, entry, alternates, related, ctaTitle, ctaLede, ctaLabel, readLabel, relatedTitle } = Astro.props;
const { Content } = await render(entry);

const dateFmt = new Intl.DateTimeFormat(locale === 'ca' ? 'ca-ES' : locale === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<BaseLayout
  locale={locale}
  routeKey="blog"
  title={entry.data.title}
  description={entry.data.description}
  path={`${route('blog', locale)}${entry.data.slug}/`}
  alternates={alternates}
  type="article"
>
  <article class="post">
    <div class="container narrow">
      <Breadcrumb
        locale={locale}
        trail={[
          { name: locale === 'ca' ? 'Blog' : locale === 'es' ? 'Blog' : 'Blog', path: route('blog', locale) },
          { name: entry.data.title, path: `${route('blog', locale)}${entry.data.slug}/` },
        ]}
      />
      <span class="post__category">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      <p class="post__meta">
        <span>{entry.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.date.toISOString()}>{dateFmt.format(entry.data.date)}</time>
      </p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--tight bg-alt">
      <div class="container">
        <h2 class="related-title">{relatedTitle}</h2>
        <div class="related-grid">
          {related.map((post) => (
            <BlogCard
              href={`${route('blog', locale)}${post.data.slug}/`}
              category={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={dateFmt.format(post.data.date)}
              readLabel={readLabel}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand locale={locale} variant="dark" title={ctaTitle} lede={ctaLede} primaryLabel={ctaLabel} />

  <ArticleSchema
    title={entry.data.title}
    description={entry.data.description}
    path={`${route('blog', locale)}${entry.data.slug}/`}
    author={entry.data.author}
    datePublished={entry.data.date}
    dateModified={entry.data.updated}
  />
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-4) var(--space-7);
  }

  .narrow {
    max-width: 720px;
  }

  .post__category {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
    margin-top: var(--space-2);
  }

  .post h1 {
    font-size: var(--text-3xl);
    margin-block: var(--space-2);
  }

  .post__meta {
    display: flex;
    gap: 0.5em;
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-5);
  }

  .prose {
    font-size: var(--text-md);
    color: var(--ink-soft);
    line-height: var(--leading-relaxed);
  }

  .prose :global(h2) {
    font-size: var(--text-xl);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .prose :global(h3) {
    font-size: var(--text-lg);
    margin-top: var(--space-5);
    margin-bottom: 0.6rem;
  }

  .prose :global(p) {
    margin-bottom: 1.2em;
    max-width: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.2em;
    padding-left: 1.4em;
  }

  .prose :global(li) {
    margin-bottom: 0.5em;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--red);
    text-decoration-thickness: 1.5px;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--red);
    padding-left: var(--space-3);
    margin: var(--space-4) 0;
    color: var(--ink);
    font-style: italic;
  }

  .prose :global(code) {
    background: var(--gray-100);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .bg-alt {
    background: var(--gray-50);
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
