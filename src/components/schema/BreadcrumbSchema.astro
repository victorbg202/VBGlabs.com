---
import { SITE_URL } from '@/i18n/locales';

interface Crumb {
  name: string;
  path: string; // root-relative, e.g. '/automatitzacions/'
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: new URL(item.path, SITE_URL).toString(),
  })),
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
