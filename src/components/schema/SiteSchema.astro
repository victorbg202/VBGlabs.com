---
/**
 * Organization + WebSite structured data — emitted once, in BaseLayout,
 * on every page. Only fields VBG Labs has actually confirmed appear here.
 * No aggregateRating, no reviews, no phone, no sameAs, no founders,
 * no invented foundingDate precision — see docs/03-structured-data.md
 * for what was deliberately left out and why.
 */
import { COMPANY, PHONE, SOCIAL_PROFILES } from '@/data/company';
import { SITE_URL } from '@/i18n/locales';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: COMPANY.legalName,
  url: SITE_URL,
  logo: `${SITE_URL}/brand/vbg-logo-black.png`,
  email: COMPANY.email,
  ...(PHONE.enabled ? { telephone: PHONE.number } : {}),
  address: {
    '@type': 'PostalAddress',
    addressLocality: COMPANY.addressLocality,
    addressRegion: COMPANY.addressRegion,
    postalCode: COMPANY.postalCode,
    addressCountry: COMPANY.addressCountry,
  },
  areaServed: COMPANY.areaServed,
  ...(SOCIAL_PROFILES.length > 0 ? { sameAs: SOCIAL_PROFILES.map((p) => p.url) } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: SITE_URL,
  name: 'VBG Labs',
  publisher: { '@id': `${SITE_URL}/#organization` },
  inLanguage: ['ca', 'es', 'en'],
};
---
<script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(website)} is:inline />
