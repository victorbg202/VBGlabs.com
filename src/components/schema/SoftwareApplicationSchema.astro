---
import { SITE_URL } from '@/i18n/locales';
import type { Locale } from '@/i18n/locales';
import { route } from '@/i18n/routes';
import { INVOICING_PLANS, INVOICING_STARTING_PRICE } from '@/data/pricing';

interface Props { locale: Locale }
const { locale } = Astro.props;
// Quote-only Starter is deliberately omitted; it is not a free offer.
const entryPlan = INVOICING_PLANS.find((plan) => plan.price === INVOICING_STARTING_PRICE)!;
const url = `${SITE_URL}${route('invoicing', locale)}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: locale === 'ca' ? 'VBG Facturació' : locale === 'es' ? 'VBG Facturación' : 'VBG Invoicing',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url,
  offers: {
    '@type': 'Offer',
    name: entryPlan.name[locale],
    price: entryPlan.price!.toFixed(2),
    priceCurrency: 'EUR',
    url,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: entryPlan.price!.toFixed(2),
      priceCurrency: 'EUR',
      unitText: 'MONTH',
      valueAddedTaxIncluded: false,
    },
  },
  provider: { '@id': `${SITE_URL}/#organization` },
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
