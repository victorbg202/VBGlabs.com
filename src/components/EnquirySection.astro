---
import ContactForm from '@/components/ContactForm.astro';
import { CONTACT_COPY, type EnquiryId } from '@/data/enquiries';
import type { Locale } from '@/i18n/locales';
interface Props { locale: Locale; interest: EnquiryId; }
const {locale,interest} = Astro.props;
const copy = CONTACT_COPY[locale];
const item = copy.enquiries[interest];
---
<section id="parlem" class="section enquiry-section" aria-labelledby="enquiry-heading">
  <div class="container enquiry-grid">
    <div>
      <p class="eyebrow">{item.label}</p>
      <h2 id="enquiry-heading">{item.title}</h2>
      <p class="lede">{item.body}</p>
      <h3>{copy.heading}</h3>
      <p class="response">{copy.response}</p>
      {interest !== 'invoicing' && <p>{copy.next}</p>}
      <p>{copy.free}</p>
      {interest !== 'invoicing' && <p class="note">{copy.paid}</p>}
      <p class="note">{copy.sensitive}</p>
    </div>
    <div class="enquiry-card"><ContactForm locale={locale} interest={interest} contextLabel={item.label} messagePlaceholder={item.prompt} /></div>
  </div>
</section>
<style>
  .enquiry-section{background:var(--red-50);scroll-margin-top:100px;}
  .enquiry-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-5);align-items:start;}
  .enquiry-grid>*{min-width:0;}
  h2{font-size:var(--text-2xl);max-width:25ch;margin-block:var(--space-2) var(--space-3);overflow-wrap:break-word;}
  h3{font-size:var(--text-md);margin-top:var(--space-4);}
  .lede{font-size:var(--text-md);}
  p+p{margin-top:var(--space-3);}
  .response{font-weight:700;color:var(--ink);margin-top:var(--space-2);}
  .note{font-size:var(--text-sm);color:var(--muted);}
  .enquiry-card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius-md);padding:clamp(1.1rem,3vw,2rem);}
  @media(min-width:980px){.enquiry-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-7);}}
</style>
