---
import { INVOICING_PLANS } from '@/data/pricing';
import { route } from '@/i18n/routes';
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';
import Icon from '@/components/Icon.astro';

interface Props {
  locale: Locale;
  planLabels: { starter: string; pro: string; business: string };
}

const { locale, planLabels } = Astro.props;
const ui = t(locale);
const name = { starter: planLabels.starter, pro: planLabels.pro, business: planLabels.business };
---
<div class="plans">
  {INVOICING_PLANS.map((plan, i) => (
    <div class={`plan ${plan.highlighted ? 'plan--highlighted' : ''}`} data-reveal style={`--i:${i}`}>
      {plan.highlighted && <span class="plan__badge">{locale === 'ca' ? 'Més triat' : locale === 'es' ? 'Más elegido' : 'Most popular'}</span>}
      <h3>{name[plan.id]}</h3>
      <p class="plan__price">
        {plan.priceIsFrom && <span class="plan__from">{ui.common.priceFrom}</span>}
        <span class="plan__amount tabular">{plan.price.toFixed(2).replace('.', locale === 'en' ? '.' : ',')}€</span>
        <span class="plan__suffix">{ui.common.month} {ui.common.plusVat}</span>
      </p>
      <p class="plan__limits">{plan.limits[locale]}</p>
      <ul class="plan__features">
        {plan.features[locale].map((f) => (
          <li><Icon name="check" size={16} /> {f}</li>
        ))}
      </ul>
      <a href={route('contact', locale)} class={`btn ${plan.highlighted ? 'btn-primary' : 'btn-outline'} plan__cta`}>
        {ui.common.requestDemo}
      </a>
    </div>
  ))}
</div>
<p class="plans__note">{ui.common.priceOrientativeNote}</p>

<style>
  .plans {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 860px) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }

  .plan {
    position: relative;
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    transition: transform var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
  }

  .plan:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .plan--highlighted {
    border-color: var(--red);
    box-shadow: var(--shadow-md);
  }

  .plan--highlighted:hover {
    box-shadow: var(--shadow-lg);
  }

  .plan__badge {
    position: absolute;
    top: -13px;
    left: var(--space-4);
    background: var(--red);
    color: #fff;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.25em 0.8em;
    border-radius: var(--radius-pill);
  }

  .plan h3 {
    font-size: var(--text-md);
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    flex-wrap: wrap;
  }

  .plan__from {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .plan__amount {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--ink);
  }

  .plan__suffix {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .plan__limits {
    font-size: var(--text-xs);
    color: var(--red-600);
    font-weight: 600;
  }

  .plan__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .plan__features li svg {
    color: var(--ok);
    flex: none;
    margin-top: 0.2em;
  }

  .plan__cta {
    justify-content: center;
    margin-top: 0.3rem;
  }

  .plans__note {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: var(--space-3);
    text-align: center;
  }
</style>
