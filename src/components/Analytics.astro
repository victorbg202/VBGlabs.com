---
import { ANALYTICS } from '@/data/company';

const enabled = ANALYTICS.enabled && /^G-[A-Z0-9]+$/.test(ANALYTICS.id);
const measurementId = ANALYTICS.id;
const consentKey = ANALYTICS.consent.key;
const consentVersion = ANALYTICS.consent.version;
const consentMaxAgeMs = ANALYTICS.consent.maxAgeDays * 24 * 60 * 60 * 1000;
---

{
  enabled && (
    <script
      is:inline
      define:vars={{ measurementId, consentKey, consentVersion, consentMaxAgeMs }}
    >
      (() => {
        const disableKey = `ga-disable-${measurementId}`;
        let tagLoaded = false;
        let analyticsGranted = false;

        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () {
          window.dataLayer.push(arguments);
        };

        // Consent Mode v2 defaults. Advertising storage and signals remain
        // disabled because VBG Labs currently uses Analytics only.
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
          security_storage: 'granted',
          wait_for_update: 500,
        });
        window.gtag('set', 'ads_data_redaction', true);
        window[disableKey] = true;

        function readConsent() {
          try {
            const raw = localStorage.getItem(consentKey);
            if (!raw) return null;

            const consent = JSON.parse(raw);
            const validDecision = consent.analytics === 'granted' || consent.analytics === 'denied';
            const validVersion = consent.version === consentVersion;
            const validDate = Number.isFinite(consent.updatedAt) && Date.now() - consent.updatedAt <= consentMaxAgeMs;

            if (!validDecision || !validVersion || !validDate) {
              localStorage.removeItem(consentKey);
              return null;
            }

            return consent.analytics;
          } catch {
            return null;
          }
        }

        function injectTag() {
          if (tagLoaded) return;
          tagLoaded = true;

          window.gtag('js', new Date());
          window.gtag('config', measurementId, {
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
            cookie_domain: 'auto',
            send_page_view: true,
          });

          const script = document.createElement('script');
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
          script.dataset.vbgAnalytics = 'ga4';
          document.head.appendChild(script);
        }

        function grantAnalytics() {
          analyticsGranted = true;
          window[disableKey] = false;
          window.gtag('consent', 'update', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          injectTag();
        }

        function clearAnalyticsCookies() {
          const names = document.cookie
            .split(';')
            .map((part) => part.split('=')[0].trim())
            .filter((name) => name === '_ga' || name.startsWith('_ga_'));
          const rootDomain = location.hostname.replace(/^www\./, '');
          const domains = ['', location.hostname, `.${rootDomain}`];

          for (const name of names) {
            for (const domain of domains) {
              const domainPart = domain ? ` Domain=${domain};` : '';
              document.cookie = `${name}=; Max-Age=0; Path=/;${domainPart} SameSite=Lax`;
            }
          }
        }

        function denyAnalytics() {
          analyticsGranted = false;
          window.gtag('consent', 'update', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          window[disableKey] = true;
          clearAnalyticsCookies();
        }

        window.vbgTrackEvent = function (eventName, parameters = {}) {
          if (!analyticsGranted || typeof eventName !== 'string' || !eventName) return;
          window.gtag('event', eventName, parameters);
        };

        window.addEventListener('vbg:consent-change', (event) => {
          if (event.detail?.analytics === true) grantAnalytics();
          else denyAnalytics();
        });

        if (readConsent() === 'granted') grantAnalytics();
        else denyAnalytics();

        function linkLocation(link) {
          if (link.closest('#site-header, #mobile-menu')) return 'header';
          if (link.closest('.hero')) return 'hero';
          if (link.closest('.cta-band')) return 'cta_band';
          if (link.closest('.plan')) return 'pricing';
          if (link.closest('footer')) return 'footer';
          return 'content';
        }

        document.addEventListener('click', (event) => {
          if (!(event.target instanceof Element)) return;
          const link = event.target.closest('a');
          if (!(link instanceof HTMLAnchorElement)) return;

          const destination = new URL(link.href, location.href);
          const contactPaths = ['/contacte/', '/es/contacto/', '/en/contact/'];

          if (destination.origin === location.origin && contactPaths.includes(destination.pathname)) {
            window.vbgTrackEvent('cta_click', {
              cta_location: linkLocation(link),
              destination_path: destination.pathname,
              page_language: document.documentElement.lang,
            });
          } else if (destination.protocol === 'mailto:' || destination.protocol === 'tel:') {
            window.vbgTrackEvent('contact_click', {
              contact_method: destination.protocol === 'mailto:' ? 'email' : 'phone',
              link_location: linkLocation(link),
              page_language: document.documentElement.lang,
            });
          }
        });
      })();
    </script>
  )
}
