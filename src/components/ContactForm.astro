---
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';
import { route } from '@/i18n/routes';
import { COMPANY } from '@/data/company';
import { CONTACT_COPY, ENQUIRY_IDS, type EnquiryId, type ContactSource } from '@/data/enquiries';
interface Props {
  locale: Locale; id?: string; compact?: boolean; interest?: string; contextLabel?: string;
  sourcePath?: string; sector?: string; messagePlaceholder?: string; sources?: ContactSource[];
  general?: boolean; calculator?: boolean;
}
const {locale,id='contact-form',interest='',contextLabel='',sourcePath=Astro.url.pathname,sector='',messagePlaceholder,sources=[],general=false,calculator=false} = Astro.props;
const ui=t(locale);
const copy=CONTACT_COPY[locale];
const kind:EnquiryId=ENQUIRY_IDS.includes(interest as EnquiryId)?interest as EnquiryId:'general';
const item=copy.enquiries[kind];
const selectedLabel=contextLabel||item.label;
---
<form id={id} class="contact-form contact-form--compact" action={`https://formsubmit.co/ajax/${COMPANY.email}`} method="POST" novalidate
  data-contact-form data-general={general?'true':undefined} data-calculator-form={calculator?'true':undefined}
  data-config={JSON.stringify({copy,kind,interest,contextLabel:selectedLabel,sourcePath,sources,messagePlaceholder})}>
  <input type="hidden" name="_subject" value={`Nova sol·licitud — ${selectedLabel}`} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />
  <input type="hidden" name="source_page" value={sourcePath} />
  <input type="hidden" name="page_language" value={locale} />
  <input type="hidden" name="solution_name" value={selectedLabel} />
  <input type="hidden" name="enquiry_type" value={kind==='invoicing'?'demo':'project'} />
  <input type="hidden" name="form_page" value={Astro.url.pathname} />
  <input type="hidden" name="source_title" value={selectedLabel} />
  {sector && <input type="hidden" name="sector" value={sector} />}
  {!general && <input type="hidden" name="interest" value={interest||'general'} />}
  {calculator && <input type="hidden" name="calculator_summary" value="" />}
  <p class="form-context" data-form-context>{copy.context}: <strong data-context-label>{selectedLabel}</strong></p>
  <p class="form-origin" data-form-origin hidden></p>
  <p class="form-help" data-context-body hidden></p>
  <div class="hp" aria-hidden="true"><label for={`${id}-website`}>Website</label><input type="text" id={`${id}-website`} name="_honey" tabindex="-1" autocomplete="off" /></div>
  <div class="field"><label for={`${id}-name`}>{ui.form.name} <span class="req">*</span></label><input type="text" id={`${id}-name`} name="name" required maxlength="120" autocomplete="name" placeholder={ui.form.namePlaceholder} /></div>
  <div class="field"><label for={`${id}-email`}>{ui.form.email} <span class="req">*</span></label><input type="email" id={`${id}-email`} name="email" required maxlength="254" autocomplete="email" placeholder={ui.form.emailPlaceholder} /></div>
  {general && <div class="field"><label for={`${id}-interest`}>{ui.form.interest} ({copy.optional})</label><select id={`${id}-interest`} name="interest">
    {ENQUIRY_IDS.map(key=><option value={key} selected={key===kind}>{copy.enquiries[key].label}</option>)}
  </select></div>}
  <div class="field" data-optional-for="training" hidden={kind!=='training'}>
    <label for={`${id}-participants`}>{copy.participants} ({copy.optional})</label><input type="number" id={`${id}-participants`} name="participants" min="1" max="100000" step="1" inputmode="numeric" disabled={kind!=='training'} />
  </div>
  <div class="field" data-optional-for="invoicing" hidden={kind!=='invoicing'}>
    <label for={`${id}-invoices`}>{copy.invoices} ({copy.optional})</label><input type="number" id={`${id}-invoices`} name="monthly_invoices" min="0" max="10000000" step="1" inputmode="numeric" disabled={kind!=='invoicing'} />
  </div>
  <div class="field"><label for={`${id}-message`}>{ui.form.message} <span class="req">*</span></label><textarea id={`${id}-message`} name="message" rows="5" required maxlength="8000" placeholder={messagePlaceholder??item.prompt}></textarea></div>
  <div class="field field--checkbox"><input type="checkbox" id={`${id}-privacy`} name="privacy" value="accepted" required /><label for={`${id}-privacy`}>{ui.form.privacy} <a href={route('privacy',locale)}>{ui.form.privacyLink}</a> <span class="req">*</span></label></div>
  <div id={`${id}-status`} class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
  <button type="submit" class="btn btn-primary contact-form__submit"><span class="btn-label">{item.submit}</span></button>
  <p class="form-help">{copy.response}</p>
  <noscript><p>{copy.noScript} <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>.</p></noscript>
</form>

<style>
  [hidden] { display: none !important; }
  .form-context { font-size:var(--text-sm); color:var(--ink); }
  .form-origin,.form-help { font-size:var(--text-sm); color:var(--muted); overflow-wrap:anywhere; }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .contact-form--compact .contact-form__row { grid-template-columns: minmax(0,1fr); }
  .contact-form--compact .field input:not([type='checkbox']),
  .contact-form--compact .field textarea { min-width: 0; width: 100%; }

  @media (min-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .req {
    color: var(--red);
  }

  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: var(--text-base);
    padding: 0.75em 0.9em;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--ink);
    min-height: 48px;
  }

  .field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--red);
  }

  .field input:invalid[data-touched='true'],
  .field textarea:invalid[data-touched='true'] {
    border-color: var(--red-600);
  }

  .field--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .field--checkbox input {
    min-height: auto;
    width: 20px;
    height: 20px;
    margin-top: 0.15em;
    flex: none;
    accent-color: var(--red);
  }

  .field--checkbox label {
    min-width: 0;
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .field--checkbox a {
    color: var(--red);
  }

  .form-status {
    font-size: var(--text-sm);
    min-height: 1.2em;
    padding: 0.6em 0.9em;
    border-radius: var(--radius-sm);
  }

  .form-status:empty {
    display: none;
  }

  .form-status[data-state='success'],
  .form-status[data-state='error'] {
    animation: status-in 0.3s var(--ease);
  }

  .form-status[data-state='success'] {
    background: var(--ok-wash);
    color: var(--teal-700);
  }

  .form-status[data-state='error'] {
    background: var(--red-50);
    color: var(--red-700);
  }

  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-form.is-invalid .field input:invalid[data-touched='true'],
  .contact-form.is-invalid .field textarea:invalid[data-touched='true'] {
    animation: field-shake 0.35s var(--ease);
  }

  @keyframes field-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-status[data-state='success'],
    .form-status[data-state='error'],
    .contact-form.is-invalid .field input:invalid[data-touched='true'],
    .contact-form.is-invalid .field textarea:invalid[data-touched='true'] {
      animation: none;
    }
  }

  .contact-form__submit {
    align-self: flex-start;
  }

  .contact-form__submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
</style>
<script>import '@/scripts/contact-form';</script>
