---
import { t } from '@/i18n/ui';
import type { Locale } from '@/i18n/locales';
import { route } from '@/i18n/routes';
import { COMPANY } from '@/data/company';

interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id = 'contact-form' } = Astro.props;
const ui = t(locale);

const interestOptions: Record<Locale, { value: string; label: string }[]> = {
  ca: [
    { value: 'automations', label: "Automatitzacions" },
    { value: 'consulting', label: 'Consultoria' },
    { value: 'training', label: 'Formació' },
    { value: 'invoicing', label: 'VBG Facturació' },
    { value: 'postcraft', label: 'Postcraft' },
    { value: 'other', label: 'Encara no ho sé' },
  ],
  es: [
    { value: 'automations', label: 'Automatizaciones' },
    { value: 'consulting', label: 'Consultoría' },
    { value: 'training', label: 'Formación' },
    { value: 'invoicing', label: 'VBG Facturación' },
    { value: 'postcraft', label: 'Postcraft' },
    { value: 'other', label: 'Todavía no lo sé' },
  ],
  en: [
    { value: 'automations', label: 'Automation' },
    { value: 'consulting', label: 'Consulting' },
    { value: 'training', label: 'Training' },
    { value: 'invoicing', label: 'VBG Invoicing' },
    { value: 'postcraft', label: 'Postcraft' },
    { value: 'other', label: "I'm not sure yet" },
  ],
};
---
<form id={id} class="contact-form" action={`https://formsubmit.co/ajax/${COMPANY.email}`} method="POST" novalidate>
  <input type="hidden" name="_subject" value="Nova sol·licitud — vbglabs.com" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="true" />

  {/* Honeypot: hidden from sighted/keyboard users via CSS + tabindex,
      labelled so screen readers understand it's not for them either. */}
  <div class="hp" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input type="text" id={`${id}-website`} name="_honey" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__row">
    <div class="field">
      <label for={`${id}-name`}>{ui.form.name} <span class="req">*</span></label>
      <input type="text" id={`${id}-name`} name="name" required autocomplete="name" placeholder={ui.form.namePlaceholder} />
    </div>
    <div class="field">
      <label for={`${id}-company`}>{ui.form.company}</label>
      <input type="text" id={`${id}-company`} name="company" autocomplete="organization" placeholder={ui.form.companyPlaceholder} />
    </div>
  </div>

  <div class="contact-form__row">
    <div class="field">
      <label for={`${id}-email`}>{ui.form.email} <span class="req">*</span></label>
      <input type="email" id={`${id}-email`} name="email" required autocomplete="email" placeholder={ui.form.emailPlaceholder} />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>{ui.form.phone}</label>
      <input type="tel" id={`${id}-phone`} name="phone" autocomplete="tel" placeholder={ui.form.phonePlaceholder} />
    </div>
  </div>

  <div class="field">
    <label for={`${id}-interest`}>{ui.form.interest}</label>
    <select id={`${id}-interest`} name="interest">
      <option value="">{ui.form.interestDefault}</option>
      {interestOptions[locale].map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
  </div>

  <div class="field">
    <label for={`${id}-message`}>{ui.form.message} <span class="req">*</span></label>
    <textarea id={`${id}-message`} name="message" rows="4" required placeholder={ui.form.messagePlaceholder}></textarea>
  </div>

  <div class="field field--checkbox">
    <input type="checkbox" id={`${id}-privacy`} name="privacy" value="accepted" required />
    <label for={`${id}-privacy`}>{ui.form.privacy} <a href={route('privacy', locale)}>{ui.form.privacyLink}</a> <span class="req">*</span></label>
  </div>

  <div class="form-status" role="status" aria-live="polite"></div>

  <button type="submit" class="btn btn-primary contact-form__submit">
    <span class="btn-label">{ui.form.submit}</span>
  </button>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .req {
    color: var(--red);
  }

  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: var(--text-base);
    padding: 0.75em 0.9em;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--ink);
    min-height: 48px;
  }

  .field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--red);
  }

  .field input:invalid[data-touched='true'],
  .field textarea:invalid[data-touched='true'] {
    border-color: var(--red-600);
  }

  .field--checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .field--checkbox input {
    min-height: auto;
    width: 20px;
    height: 20px;
    margin-top: 0.15em;
    flex: none;
    accent-color: var(--red);
  }

  .field--checkbox label {
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .field--checkbox a {
    color: var(--red);
  }

  .form-status {
    font-size: var(--text-sm);
    min-height: 1.2em;
    padding: 0.6em 0.9em;
    border-radius: var(--radius-sm);
  }

  .form-status:empty {
    display: none;
  }

  .form-status[data-state='success'],
  .form-status[data-state='error'] {
    animation: status-in 0.3s var(--ease);
  }

  .form-status[data-state='success'] {
    background: var(--ok-wash);
    color: var(--teal-700);
  }

  .form-status[data-state='error'] {
    background: var(--red-50);
    color: var(--red-700);
  }

  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-form.is-invalid .field input:invalid[data-touched='true'],
  .contact-form.is-invalid .field textarea:invalid[data-touched='true'] {
    animation: field-shake 0.35s var(--ease);
  }

  @keyframes field-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-status[data-state='success'],
    .form-status[data-state='error'],
    .contact-form.is-invalid .field input:invalid[data-touched='true'],
    .contact-form.is-invalid .field textarea:invalid[data-touched='true'] {
      animation: none;
    }
  }

  .contact-form__submit {
    align-self: flex-start;
  }

  .contact-form__submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
</style>

<script is:inline define:vars={{ successMsg: ui.form.success, errorMsg: ui.form.error, invalidEmailMsg: ui.form.invalidEmail, sendingLabel: ui.form.sending, submitLabel: ui.form.submit, formId: id }}>
  const form = document.getElementById(formId);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (form instanceof HTMLFormElement) {
    const status = form.querySelector('.form-status');
    const submitBtn = form.querySelector('.contact-form__submit');
    const label = form.querySelector('.btn-label');

    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('blur', () => el.setAttribute('data-touched', 'true'));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!(status instanceof HTMLElement) || !(submitBtn instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) return;

      // Honeypot: a filled hidden field means a bot filled every input.
      const honey = form.querySelector('input[name="_honey"]');
      if (honey instanceof HTMLInputElement && honey.value !== '') {
        return;
      }

      if (!form.checkValidity()) {
        form.querySelectorAll('input, textarea').forEach((el) => el.setAttribute('data-touched', 'true'));
        status.textContent = invalidEmailMsg;
        status.dataset.state = 'error';
        form.classList.remove('is-invalid');
        void form.offsetWidth; // force reflow so the shake replays on repeated invalid submits
        form.classList.add('is-invalid');
        form.querySelector('[data-touched="true"]:invalid')?.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
        return;
      }

      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
      label.textContent = sendingLabel;
      status.textContent = '';
      status.removeAttribute('data-state');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error('bad status');
        status.textContent = successMsg;
        status.dataset.state = 'success';
        form.reset();
      } catch {
        status.textContent = errorMsg;
        status.dataset.state = 'error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
        label.textContent = submitLabel;
      }
    });
  }
</script>
