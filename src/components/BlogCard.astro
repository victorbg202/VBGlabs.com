---
interface Props {
  href: string;
  category: string;
  title: string;
  description: string;
  date: string;
  readLabel: string;
  /** Defaults to h3 (cards under a section h2, e.g. the home teaser).
   *  Pass "h2" on the blog listing page, where cards follow the page's
   *  h1 with no h2 in between. */
  headingLevel?: 'h2' | 'h3';
}

const { href, category, title, description, date, readLabel, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---
<a href={href} class="blog-card" data-reveal>
  <span class="blog-card__category">{category}</span>
  <Heading>{title}</Heading>
  <p>{description}</p>
  <span class="blog-card__meta">
    <time>{date}</time>
    <span class="blog-card__read">{readLabel} →</span>
  </span>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: transform var(--duration-fast) var(--ease), box-shadow var(--duration-fast) var(--ease);
  }

  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .blog-card__category {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }

  .blog-card h2,
  .blog-card h3 {
    font-size: var(--text-md);
  }

  .blog-card p {
    font-size: var(--text-sm);
    color: var(--muted);
    flex: 1;
  }

  .blog-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: 0.3rem;
  }

  .blog-card__read {
    color: var(--red);
    font-weight: 600;
  }
</style>
