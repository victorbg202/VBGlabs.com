---
/**
 * Click-to-explore feature tabs: the description list stays put, one shared
 * ProductFrame swaps its panel to match whichever tab is active. Replaces
 * the old passive "scroll past four stacked frames" narrative with
 * something the user actually drives. Auto-advances slowly (paused on
 * hover/focus, off entirely under prefers-reduced-motion) so a visitor who
 * never clicks still sees the other three states.
 */
import ProductFrame from '@/components/ProductFrame.astro';
import InvoicingPanels from '@/components/InvoicingPanels.astro';

interface Item {
  variant: 'dashboard' | 'invoices' | 'review' | 'reports';
  tag: string;
  title: string;
  body: string;
}

interface Props {
  items: Item[];
  frameLabel: string;
  tablistLabel: string;
  panelLabels: {
    thisMonth: string;
    correct: string;
    pending: string;
    supplier: string;
    amount: string;
    status: string;
    okStatus: string;
    reviewTitle: string;
    reviewNote: string;
    reportTitle: string;
    vat: string;
    withholding: string;
  };
}

const { items, frameLabel, tablistLabel, panelLabels } = Astro.props;
---
<div class="product-tabs" data-reveal>
  <div class="product-tabs__nav" role="tablist" aria-label={tablistLabel}>
    {items.map((item, i) => (
      <button
        type="button"
        role="tab"
        id={`ptab-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`ppanel-${i}`}
        tabindex={i === 0 ? 0 : -1}
        class="product-tabs__tab"
        data-index={i}
      >
        <span class="product-tabs__tag">{item.tag}</span>
        <span class="product-tabs__title">{item.title}</span>
        <span class="product-tabs__body">{item.body}</span>
        <span class="product-tabs__progress"><span class="product-tabs__progress-fill"></span></span>
      </button>
    ))}
  </div>

  <div class="product-tabs__stage">
    <ProductFrame label={frameLabel}>
      {items.map((item, i) => (
        <div class="product-tabs__panel" role="tabpanel" id={`ppanel-${i}`} aria-labelledby={`ptab-${i}`} hidden={i !== 0}>
          <InvoicingPanels variant={item.variant} labels={panelLabels} />
        </div>
      ))}
    </ProductFrame>
  </div>
</div>

<style>
  .product-tabs {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 860px) {
    .product-tabs {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-6);
    }

    .product-tabs__stage {
      position: sticky;
      top: calc(76px + var(--space-4));
    }
  }

  .product-tabs__nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-tabs__tab {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border: 1.5px solid transparent;
    transition: background-color var(--duration-fast) var(--ease), border-color var(--duration-fast) var(--ease);
  }

  .product-tabs__tab:hover {
    background: var(--gray-50);
  }

  .product-tabs__tab[aria-selected='true'] {
    background: var(--white);
    border-color: var(--line);
    box-shadow: var(--shadow-sm);
  }

  .product-tabs__tag {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray-400);
    transition: color var(--duration-fast) var(--ease);
  }

  .product-tabs__tab[aria-selected='true'] .product-tabs__tag {
    color: var(--red);
  }

  .product-tabs__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-md);
    color: var(--ink);
  }

  .product-tabs__body {
    font-size: var(--text-sm);
    color: var(--muted);
    max-width: 44ch;
    display: none;
  }

  .product-tabs__tab[aria-selected='true'] .product-tabs__body {
    display: block;
  }

  .product-tabs__progress {
    height: 2px;
    border-radius: 2px;
    background: var(--line-soft);
    overflow: hidden;
    margin-top: 0.2rem;
    display: none;
  }

  .product-tabs__tab[aria-selected='true'] .product-tabs__progress {
    display: block;
  }

  .product-tabs__progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--red);
  }

  .product-tabs[data-autoplay] .product-tabs__tab[aria-selected='true'] .product-tabs__progress-fill {
    animation: tab-progress 6s linear forwards;
  }

  .product-tabs[data-autoplay='paused'] .product-tabs__progress-fill {
    animation-play-state: paused;
  }

  @keyframes tab-progress {
    from {
      width: 0%;
    }
    to {
      width: 100%;
    }
  }

  .product-tabs__panel[hidden] {
    display: none;
  }
</style>

<script>
  const initialized = new WeakSet<HTMLElement>();
  const duration = 6000;

  function initProductTabs() {
    document.querySelectorAll<HTMLElement>('.product-tabs').forEach((group) => {
      if (initialized.has(group)) return;
      initialized.add(group);
      const nav = group.querySelector<HTMLElement>('.product-tabs__nav');
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('.product-tabs__tab'));
      const panels = Array.from(group.querySelectorAll<HTMLElement>('.product-tabs__panel'));
      if (!nav || !tabs.length) return;
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let index = Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true'));
      let timer: number | null = null;
      let startedAt = 0;
      let remaining = duration;
      let visible = false;
      let hovered = nav.matches(':hover');
      let focused = nav.contains(document.activeElement);

      function pause() {
        if (timer !== null) {
          window.clearTimeout(timer);
          timer = null;
          remaining = Math.max(0, remaining - (performance.now() - startedAt));
        }
        if (group.hasAttribute('data-autoplay')) group.dataset.autoplay = 'paused';
      }

      function syncPlayback() {
        if (!visible || hovered || focused || document.hidden || (motion.matches && !document.documentElement.hasAttribute('data-demo-motion-enabled'))) {
          pause();
          if (motion.matches && !document.documentElement.hasAttribute('data-demo-motion-enabled')) group.removeAttribute('data-autoplay');
          return;
        }
        if (timer !== null) return;
        group.dataset.autoplay = 'running';
        startedAt = performance.now();
        timer = window.setTimeout(() => {
          timer = null;
          activate((index + 1) % tabs.length);
        }, remaining);
      }

      function restart() {
        pause();
        remaining = duration;
        // Restart the same bar too, e.g. after scrolling back into view.
        group.removeAttribute('data-autoplay');
        void group.offsetWidth;
        syncPlayback();
      }

      function activate(nextIndex: number, focusTab = false) {
        index = nextIndex;
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          if (selected && focusTab) tab.focus();
        });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
        restart();
      }

      tabs.forEach((tab, i) => tab.addEventListener('click', () => activate(i)));
      nav.addEventListener('mouseenter', () => { hovered = true; syncPlayback(); });
      nav.addEventListener('mouseleave', () => { hovered = false; syncPlayback(); });
      nav.addEventListener('focusin', () => { focused = true; syncPlayback(); });
      nav.addEventListener('focusout', (event) => {
        focused = event.relatedTarget instanceof Node && nav.contains(event.relatedTarget);
        syncPlayback();
      });
      nav.addEventListener('keydown', (event) => {
        let next: number | undefined;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        if (next !== undefined) { event.preventDefault(); activate(next, true); }
      });

      const onVisibility = () => syncPlayback();
      const onMotion = () => restart();
      document.addEventListener('visibilitychange', onVisibility);
      document.addEventListener('vbg:demo-motion-change', onMotion);
      motion.addEventListener('change', onMotion);
      const observer = 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
        const entered = entry.isIntersecting && !visible;
        visible = entry.isIntersecting;
        if (entered) restart();
        else syncPlayback();
      }, { threshold: 0.3 }) : null;
      observer?.observe(group);
      // No observer: leave the tabs usable manually, without a stuck timer.
      document.addEventListener('astro:before-swap', () => {
        pause();
        observer?.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
        document.removeEventListener('vbg:demo-motion-change', onMotion);
        motion.removeEventListener('change', onMotion);
      }, { once: true });
    });
  }

  initProductTabs();
  document.addEventListener('astro:page-load', initProductTabs);
</script>
