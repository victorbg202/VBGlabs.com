---
/**
 * Animated mini-demo of the AI assistant on the VBG Facturació page: the
 * user's question appears, a typing indicator plays, then the assistant's
 * reply lands. Dramatizes the actual feature (ask your invoices a question
 * in plain language) rather than being decoration for its own sake.
 */
import Icon from '@/components/Icon.astro';

interface Props {
  userMsg: string;
  botMsg: string;
}

const { userMsg, botMsg } = Astro.props;
---
<div class="assistant-demo">
  <div class="assistant-demo__msg assistant-demo__msg--user">{userMsg}</div>
  <div class="assistant-demo__msg assistant-demo__msg--typing" aria-hidden="true">
    <span class="assistant-demo__dot"></span><span class="assistant-demo__dot"></span><span class="assistant-demo__dot"></span>
  </div>
  <div class="assistant-demo__msg assistant-demo__msg--bot">
    <Icon name="sparkle" size={16} /> {botMsg}
  </div>
</div>

<style>
  .assistant-demo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 560px;
  }

  .assistant-demo__msg {
    padding: 0.9em 1.2em;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }

  .assistant-demo__msg--user {
    align-self: flex-end;
    background: var(--red);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .assistant-demo__msg--bot {
    align-self: flex-start;
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--ink-soft);
    border-bottom-left-radius: 4px;
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
  }

  .assistant-demo__msg--bot :global(svg) {
    color: var(--red);
    flex: none;
    margin-top: 0.15em;
  }

  .assistant-demo__msg--typing {
    align-self: flex-start;
    background: var(--white);
    border: 1px solid var(--line);
    display: none;
    align-items: center;
    gap: 5px;
    padding: 1em 1.2em;
    width: fit-content;
  }

  .assistant-demo__msg--typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gray-400);
    animation: typing-bounce 1s infinite ease-in-out;
  }

  .assistant-demo__msg--typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .assistant-demo__msg--typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  /* The demo owns its animation state: it does not depend on the global
     scroll-reveal script having initialized first. */
  .assistant-demo[data-animated] .assistant-demo__msg--user {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .assistant-demo[data-animated].is-visible .assistant-demo__msg--user {
    opacity: 1;
    transform: none;
  }

  .assistant-demo[data-animated] .assistant-demo__msg--typing,
  .assistant-demo[data-animated] .assistant-demo__msg--bot {
    display: none;
  }

  .assistant-demo[data-animated].show-typing .assistant-demo__msg--typing {
    display: flex;
  }

  .assistant-demo[data-animated].show-bot .assistant-demo__msg--typing {
    display: none;
  }

  .assistant-demo[data-animated].show-bot .assistant-demo__msg--bot {
    display: flex;
    opacity: 0;
    animation: msg-in 0.35s var(--ease) forwards;
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

</style>

<script>
  const initialized = new WeakSet<HTMLElement>();

  function initAssistantDemos() {
    document.querySelectorAll<HTMLElement>('.assistant-demo').forEach((demo) => {
      if (initialized.has(demo)) return;
      initialized.add(demo);
      let timers: number[] = [];
      let visible = false;

      function reset() {
        timers.forEach((id) => window.clearTimeout(id));
        timers = [];
        demo.classList.remove('is-visible', 'show-typing', 'show-bot');
      }

      function play() {
        reset();
        if (!('IntersectionObserver' in window)) {
          demo.removeAttribute('data-animated');
          return;
        }
        demo.setAttribute('data-animated', '');
        if (!visible || document.hidden) return;
        // Flush the hidden state so the question animates on every re-entry.
        void demo.offsetWidth;
        demo.classList.add('is-visible');
        timers = [
          window.setTimeout(() => demo.classList.add('show-typing'), 500),
          window.setTimeout(() => demo.classList.add('show-bot'), 1500),
        ];
      }

      const observer = 'IntersectionObserver' in window ? new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        play();
      }, { threshold: 0.4 }) : null;
      const onVisibility = () => play();
      document.addEventListener('visibilitychange', onVisibility);
      play();
      observer?.observe(demo);
      document.addEventListener('astro:before-swap', () => {
        reset();
        observer?.disconnect();
        document.removeEventListener('visibilitychange', onVisibility);
      }, { once: true });
    });
  }

  initAssistantDemos();
  document.addEventListener('astro:page-load', initAssistantDemos);
</script>
