---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import type { Locale } from '@/i18n/locales';
import type { RouteKey } from '@/i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  crumbName: string;
  crumbPath: string;
  updated: string;
  updatedLabel: string;
}

const { locale, routeKey, title, description, crumbName, crumbPath, updated, updatedLabel } = Astro.props;
---
<BaseLayout locale={locale} routeKey={routeKey} title={title} description={description} noindex>
  <article class="legal">
    <div class="container narrow">
      <Breadcrumb locale={locale} trail={[{ name: crumbName, path: crumbPath }]} />
      <h1>{title}</h1>
      <p class="legal__updated">{updatedLabel}: {updated}</p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-block: var(--space-4) var(--space-8);
  }

  .narrow {
    max-width: 760px;
  }

  .legal h1 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2);
  }

  .legal__updated {
    font-size: var(--text-sm);
    color: var(--muted);
    margin-bottom: var(--space-5);
  }

  .prose {
    color: var(--ink-soft);
    line-height: var(--leading-relaxed);
  }

  .prose :global(h2) {
    font-size: var(--text-lg);
    margin-top: var(--space-5);
    margin-bottom: 0.7rem;
  }

  .prose :global(p) {
    margin-bottom: 1em;
    max-width: none;
  }

  .prose :global(ul) {
    margin-bottom: 1em;
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.2em;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.6em 0.8em;
    border: 1px solid var(--line);
  }

  .prose :global(th) {
    background: var(--gray-50);
    font-weight: 600;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(a) {
    color: var(--red);
  }
</style>
