---
/**
 * Small hand-authored stroke-icon set (24x24, 1.6px stroke, currentColor).
 * Replaces the old site's emoji-as-iconography entirely, per instruction
 * (§18/§20: no emojis anywhere) and the audit's finding that emoji icons
 * read as inconsistent and unprofessional across operating systems.
 */
export type IconName =
  | 'automation'
  | 'consulting'
  | 'training'
  | 'invoicing'
  | 'postcraft'
  | 'documents'
  | 'messages'
  | 'reminders'
  | 'dashboard'
  | 'check'
  | 'arrow-right'
  | 'search'
  | 'users'
  | 'shield'
  | 'chart'
  | 'sparkle'
  | 'clock'
  | 'building'
  | 'mail'
  | 'flag';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'automation' && (
    <>
      <circle cx="12" cy="12" r="3" />
      <path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
    </>
  )}
  {name === 'consulting' && (
    <>
      <circle cx="12" cy="12" r="9.5" />
      <path d="M15 9l-2.2 5.8L7 17l2.2-5.8L15 9z" />
    </>
  )}
  {name === 'training' && (
    <>
      <path d="M2 8.5L12 4l10 4.5-10 4.5-10-4.5z" />
      <path d="M6 10.8v4.4c0 1.6 2.7 3 6 3s6-1.4 6-3v-4.4" />
      <path d="M21 8.5v6" />
    </>
  )}
  {name === 'invoicing' && (
    <>
      <path d="M6 2.5h9l3 3v16H6v-19z" />
      <path d="M15 2.5v3h3" />
      <path d="M9 12.5h6M9 15.5h6M9 9.5h3" />
    </>
  )}
  {name === 'postcraft' && (
    <>
      <rect x="3" y="4" width="18" height="13" rx="2" />
      <path d="M8 21h8M12 17v4" />
      <path d="M7 13l2.5-3L12 12l2-2.5L17 12" />
    </>
  )}
  {name === 'documents' && (
    <>
      <path d="M7 3.5h7l4 4v13H7v-17z" />
      <path d="M14 3.5v4h4" />
      <path d="M4 7v13.5h13" opacity="0.5" />
    </>
  )}
  {name === 'messages' && (
    <>
      <path d="M4 5h13v9H9.5L6 17v-3H4V5z" />
      <path d="M9 12.5h11v6l-3-2.3H12l-3 2.3v-6z" opacity="0.55" />
    </>
  )}
  {name === 'reminders' && (
    <>
      <circle cx="12" cy="13" r="8" />
      <path d="M12 9v4l3 2" />
      <path d="M9 2.5h6M5 5l-1.8-1.8M19 5l1.8-1.8" />
    </>
  )}
  {name === 'dashboard' && (
    <>
      <rect x="3" y="3.5" width="8" height="8" rx="1.5" />
      <rect x="13" y="3.5" width="8" height="5" rx="1.5" />
      <rect x="13" y="10.5" width="8" height="10" rx="1.5" />
      <rect x="3" y="13.5" width="8" height="7" rx="1.5" />
    </>
  )}
  {name === 'check' && <path d="M4 12.5l5.5 5.5L20 6" />}
  {name === 'arrow-right' && (
    <>
      <path d="M4 12h16" />
      <path d="M14 6l6 6-6 6" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M20 20l-5-5" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3.2" />
      <path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" />
      <path d="M16 4.6c1.7.4 3 2 3 3.8 0 1.8-1.3 3.4-3 3.8" opacity="0.6" />
      <path d="M18 14.3c2.2.6 3.5 2.3 3.5 5.2" opacity="0.6" />
    </>
  )}
  {name === 'shield' && <path d="M12 2.5l7.5 3v6c0 5-3.2 8.4-7.5 10-4.3-1.6-7.5-5-7.5-10v-6l7.5-3z" />}
  {name === 'chart' && (
    <>
      <path d="M4 20V10M11 20V4M18 20v-7" />
      <path d="M2 20h20" />
    </>
  )}
  {name === 'sparkle' && (
    <path d="M12 2.5l1.8 5.7L19.5 10l-5.7 1.8L12 17.5l-1.8-5.7L4.5 10l5.7-1.8L12 2.5z" />
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5.5l4 2.3" />
    </>
  )}
  {name === 'building' && (
    <>
      <path d="M4 21V4.5L13 3v18" />
      <path d="M13 8.5l7 1.5V21" />
      <path d="M7.5 8h2M7.5 12h2M7.5 16h2M16 13.5h2M16 17h2" />
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="2.5" y="5" width="19" height="14" rx="2" />
      <path d="M3.5 6.5L12 13l8.5-6.5" />
    </>
  )}
  {name === 'flag' && (
    <>
      <path d="M5 21V3" />
      <path d="M5 4h13l-3 4.5L18 13H5" />
    </>
  )}
</svg>
