---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/HomeHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BeforeAfterRow from '@/components/BeforeAfterRow.astro';
import ProductFrame from '@/components/ProductFrame.astro';
import InvoicingPanels from '@/components/InvoicingPanels.astro';
import StepsList from '@/components/StepsList.astro';
import PriceStrip from '@/components/PriceStrip.astro';
import BlogCard from '@/components/BlogCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { route } from '@/i18n/routes';
import { SERVICE_PRICING } from '@/data/pricing';
import { getCollection } from 'astro:content';

const locale = 'es' as const;

const posts = (await getCollection('blog', (p) => p.data.lang === locale && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const dateFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  locale={locale}
  routeKey="home"
  title="VBG Labs — Automatización, IA y software a medida para pymes"
  description="Consultora tecnológica en Almenar, Lleida. Automatizaciones, consultoría de IA, formación y software a medida para pymes y autónomos. Primera conversación sin compromiso."
>
  <HomeHero
    locale={locale}
    eyebrow="AUTOMATIZACIÓN · IA · SOFTWARE A MEDIDA"
    title="Tecnología práctica para que tu negocio funcione mejor."
    lede="Ayudamos a pymes y autónomos a simplificar procesos, quitarse de encima el trabajo repetitivo y aplicar inteligencia artificial con criterio. Primero entendemos el negocio. Después decidimos qué tecnología tiene sentido — nunca al revés."
    ctaPrimary="Cuéntanos tu caso"
    ctaSecondary="Descubre qué podemos hacer"
    note="Primera conversación sin compromiso."
  />

  <section class="section" id="que-hacemos">
    <div class="container">
      <SectionHeader
        eyebrow="QUIÉNES SOMOS"
        title="Un laboratorio digital que empieza por tu negocio, no por la tecnología"
        lede="VBG Labs es una consultora tecnológica de Almenar, Lleida. Combinamos consultoría, automatización, inteligencia artificial aplicada y desarrollo de software — y también construimos nuestros propios productos, como VBG Facturación."
      />
      <FeatureGrid
        columns={3}
        items={[
          { icon: 'search', title: 'Entendemos antes de proponer', description: 'Ninguna recomendación sale de una plantilla. Primero vemos cómo trabaja tu equipo de verdad.' },
          { icon: 'automation', title: 'Construimos, no solo asesoramos', description: 'Podemos acompañarte desde el diagnóstico hasta la implementación y la formación del equipo.' },
          { icon: 'shield', title: 'Sin ataduras a una herramienta', description: 'Usamos la tecnología que mejor resuelve el problema, no la que nos interesa vender.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader
        eyebrow="QUÉ HACEMOS"
        title="Tres maneras de hacer que el negocio vaya más fluido"
        lede="No vendemos un paquete cerrado: elegimos entre automatización, consultoría y formación según lo que realmente te haga ir más rápido."
      />
      <div class="grid-3">
        <ServiceCard
          icon="automation"
          title="Automatizaciones"
          description="Procesos, documentos, mensajes y tareas repetitivas que pueden hacerse solas, sin que tengas que estar encima."
          href={route('automations', locale)}
          linkLabel="Cómo funciona"
        />
        <ServiceCard
          icon="consulting"
          title="Consultoría"
          description="Una mirada externa y técnica sobre cómo trabaja tu negocio hoy, y qué vale la pena cambiar primero."
          href={route('consulting', locale)}
          linkLabel="Cómo funciona"
        />
        <ServiceCard
          icon="training"
          title="Formación"
          description="Que tu equipo aprenda a sacar partido real a la IA, no solo a usarla por curiosidad."
          href={route('training', locale)}
          linkLabel="Cómo funciona"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="EJEMPLOS HABITUALES"
        title="Situaciones que vemos a menudo"
        lede="Somos una empresa que empieza: todavía no tenemos casos de clientes publicados. Los siguientes ejemplos son situaciones habituales del tipo de trabajo que hacemos, no resultados garantizados para ningún negocio concreto."
      />
      <div class="ba-stack">
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="Recibes documentos por correo, los descargas uno a uno y copias los datos a mano."
          after="Los documentos se clasifican solos y solo llegan a revisión humana los casos que de verdad lo necesitan."
        />
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="Un cliente pregunta lo mismo por WhatsApp, Instagram y correo — y acabas respondiendo tres veces."
          after="Todas las conversaciones llegan a un solo sitio, con el contexto de lo que ya se ha hablado."
        />
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="Envías los recordatorios de citas o pagos uno a uno, cuando te acuerdas."
          after="Los recordatorios salen solos, a la hora adecuada, sin que tengas que pensarlo."
        />
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="La información del negocio vive repartida entre correos, notas y chats de WhatsApp."
          after="Todo queda centralizado en un solo sitio, fácil de consultar cuando hace falta."
        />
      </div>
    </div>
  </section>

  <section class="section section--dark product-showcase">
    <div class="container product-showcase__grid">
      <div>
        <p class="eyebrow">PRODUCTO PROPIO</p>
        <h2>VBG Facturación: ninguna factura recibida se vuelve a perder</h2>
        <p class="lede">
          El primer producto propio de VBG Labs. Un panel que centraliza, revisa y organiza las
          facturas que recibes, con un asistente de IA a mano para encontrar cualquier dato en segundos.
        </p>
        <ul class="showcase-list">
          <li><Icon name="dashboard" size={18} /> Dashboard con el estado de todas las facturas del mes</li>
          <li><Icon name="shield" size={18} /> Detección de posibles duplicados antes de pagarlos</li>
          <li><Icon name="chart" size={18} /> Informes fiscales (IVA, IRPF) listos para presentar</li>
          <li><Icon name="sparkle" size={18} /> Asistente de IA para encontrar cualquier factura preguntándole</li>
        </ul>
        <div class="showcase-actions">
          <a href={route('invoicing', locale)} class="btn btn-primary">Descubre VBG Facturación</a>
          <a href={route('contact', locale)} class="btn btn-outline">Solicita una demo</a>
        </div>
      </div>
      <ProductFrame label="app.vbgfacturacion.com">
        <InvoicingPanels
          variant="dashboard"
          labels={{ thisMonth: 'Facturas este mes', correct: 'Correctas', pending: 'Pendientes revisión', supplier: 'Proveedor', amount: 'Importe', status: 'A revisar', okStatus: 'Correcta', reviewTitle: '', reviewNote: '', reportTitle: '', vat: '', withholding: '' }}
        />
      </ProductFrame>
    </div>
  </section>

  <section class="section">
    <div class="container how-grid">
      <SectionHeader
        eyebrow="CÓMO TRABAJAMOS"
        title="Cinco pasos, sin sorpresas"
        lede="El mismo método tanto si contratas solo una consultoría como si acabamos implementándolo todo."
      />
      <StepsList
        steps={[
          { title: 'Entender cómo trabajas', description: 'Hablamos con quien hace el trabajo cada día, no solo con quien lo gestiona.' },
          { title: 'Detectar problemas y oportunidades', description: 'Identificamos dónde se pierde tiempo, dónde hay riesgo de error y dónde hay margen real de mejora.' },
          { title: 'Priorizar', description: 'No todo vale la pena automatizarlo. Ordenamos por impacto real y esfuerzo necesario.' },
          { title: 'Definir una hoja de ruta', description: 'Un plan concreto, con fases y presupuesto orientativo, para que decidas con información.' },
          { title: 'Implementar (si toca)', description: 'Si decides seguir, construimos, probamos con tu equipo y formamos a quien lo vaya a usar.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader
        eyebrow="POR QUÉ VBG LABS"
        title="Consultoría, implementación, formación y producto propio — bajo un mismo techo"
        lede="Es la combinación que nos diferencia: la mayoría de empresas del sector solo hacen una de estas cosas."
      />
      <FeatureGrid
        columns={4}
        items={[
          { icon: 'users', title: 'Trato cercano', description: 'Entendemos el negocio y hablamos en un lenguaje comprensible, sin tecnicismos innecesarios.' },
          { icon: 'flag', title: 'Visión práctica', description: 'No proponemos tecnología porque esté de moda. Proponemos lo que resuelve el problema real.' },
          { icon: 'training', title: 'Acompañamiento', description: 'Podemos estar presentes desde el análisis hasta la implantación y la formación del equipo.' },
          { icon: 'automation', title: 'Capacidad de ejecución', description: 'No solo recomendamos: también construimos. VBG Facturación lo demuestra.' },
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="PRECIOS" title="Precios orientativos" lede="Cada proyecto es distinto; estos son puntos de partida para hacerte una idea." />
      <PriceStrip
        locale={locale}
        items={[
          { label: 'Consultoría', band: SERVICE_PRICING.consulting },
          { label: 'Automatizaciones', band: SERVICE_PRICING.automation },
          { label: 'Formación', band: SERVICE_PRICING.training },
          { label: 'VBG Facturación', band: { min: 14.9, max: null, unit: 'month' } },
        ]}
      />
    </div>
  </section>

  <section class="section section--dark postcraft-teaser">
    <div class="container postcraft-teaser__grid">
      <div>
        <span class="soon-badge">Próximamente</span>
        <h2>Postcraft: el segundo producto de VBG Labs</h2>
        <p class="lede">
          Una plataforma para planificar y generar contenido de redes sociales entendiendo la voz
          y el estilo de cada marca. Ahora mismo en preparación.
        </p>
        <a href={route('postcraft', locale)} class="btn btn-outline">Saber más</a>
      </div>
      <div class="postcraft-mark" aria-hidden="true">
        <img src="/brand/vbg-isotype-white.webp" width="64" height="64" alt="" />
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <SectionHeader eyebrow="BLOG" title="Para pensarlo un poco más" lede="Artículos prácticos, sin relleno, sobre automatización e IA aplicada a negocios reales." />
        <div class="grid-2">
          {posts.map((post) => (
            <BlogCard
              href={`${route('blog', locale)}${post.data.slug}/`}
              category={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={dateFmt.format(post.data.date)}
              readLabel="Leer"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader eyebrow="DUDAS HABITUALES" title="Preguntas frecuentes" />
      <FaqAccordion
        items={[
          { q: '¿Necesito saber de IA o tecnología para trabajar con vosotros?', a: 'No. Hablamos en tu idioma, no en el nuestro. El trabajo técnico lo hacemos nosotros.' },
          { q: '¿Cuánto cuesta una primera consulta?', a: 'La primera conversación es sin compromiso. A partir de ahí, una consultoría orientada tiene un precio de 350–650€ + IVA según el alcance.' },
          { q: '¿Siempre acabáis recomendando automatizarlo todo?', a: 'No. A veces la mejor recomendación es no tocar nada, o solo ordenar lo que ya tienes. No todo vale la pena automatizarlo.' },
          { q: '¿Trabajáis solo con empresas de Lleida?', a: 'Somos de Almenar y conocemos bien el tejido empresarial de Lleida y Cataluña, pero trabajamos con negocios de toda España.' },
        ]}
      />
    </div>
  </section>

  <CtaBand
    locale={locale}
    variant="red"
    eyebrow="EMPECEMOS"
    title="Hablemos de tu negocio"
    lede="Sin compromiso. En 15-20 minutos sabremos si podemos ayudarte y cómo."
    primaryLabel="Cuéntanos tu caso"
    secondaryLabel="Ver todos los servicios"
    secondaryHref={route('services', locale)}
  />
</BaseLayout>

<style>
  .grid-3 { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 720px) { .grid-3 { grid-template-columns: repeat(3, 1fr); } }
  .grid-2 { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 640px) { .grid-2 { grid-template-columns: 1fr 1fr; } }
  .bg-alt { background: var(--gray-50); }
  .ba-stack { display: flex; flex-direction: column; gap: var(--space-3); }
  .product-showcase__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); align-items: center; }
  @media (min-width: 940px) { .product-showcase__grid { grid-template-columns: 1fr 1fr; } }
  .product-showcase h2 { color: var(--white); font-size: var(--text-2xl); margin-block: var(--space-2); max-width: 16ch; }
  .product-showcase .lede { color: var(--gray-400); max-width: 44ch; }
  .showcase-list { list-style: none; padding: 0; margin: var(--space-4) 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .showcase-list li { display: flex; align-items: center; gap: 0.7em; font-size: var(--text-sm); color: var(--gray-200); }
  .showcase-list :global(svg) { color: var(--red-300); flex: none; }
  .showcase-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .how-grid :global(.section-header) { max-width: 640px; }
  .soon-badge { display: inline-block; font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); background: var(--red-300); padding: 0.3em 0.9em; border-radius: var(--radius-pill); margin-bottom: var(--space-3); }
  .postcraft-teaser__grid { display: grid; grid-template-columns: 1fr; gap: var(--space-5); align-items: center; }
  @media (min-width: 780px) { .postcraft-teaser__grid { grid-template-columns: 1fr auto; } }
  .postcraft-teaser h2 { color: var(--white); font-size: var(--text-2xl); margin-bottom: var(--space-2); max-width: 18ch; }
  .postcraft-teaser .lede { color: var(--gray-400); max-width: 46ch; margin-bottom: var(--space-4); }
  .postcraft-mark { width: 140px; height: 140px; border-radius: 50%; background: var(--gray-800); display: grid; place-items: center; justify-self: center; }
</style>
