---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogCard from '@/components/BlogCard.astro';
import { route } from '@/i18n/routes';
import { getCollection } from 'astro:content';

const locale = 'es' as const;
const posts = (await getCollection('blog', (p) => p.data.lang === locale && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  locale={locale}
  routeKey="blog"
  title="Blog — Automatización e IA aplicada, sin relleno"
  description="Artículos prácticos sobre automatización, inteligencia artificial aplicada y gestión de negocio para pymes y autónomos."
>
  <PageHero
    locale={locale}
    eyebrow="BLOG"
    title="Para pensarlo un poco más"
    lede="Artículos prácticos, sin relleno, sobre automatización e IA aplicada a negocios reales."
    crumb={{ name: 'Blog', path: route('blog', locale) }}
  />
  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => (
            <BlogCard
              href={`${route('blog', locale)}${post.data.slug}/`}
              category={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={dateFmt.format(post.data.date)}
              readLabel="Leer"
            />
          ))}
        </div>
      ) : (
        <p>Todavía no hay artículos publicados.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
