---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import BeforeAfterRow from '@/components/BeforeAfterRow.astro';
import PriceStrip from '@/components/PriceStrip.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EnquirySection from '@/components/EnquirySection.astro';
import ServiceSchema from '@/components/schema/ServiceSchema.astro';
import SolutionCatalog from '@/components/SolutionCatalog.astro';
import { route } from '@/i18n/routes';
import { SERVICE_PRICING } from '@/data/pricing';

const locale = 'es' as const;
---
<BaseLayout
  locale={locale}
  routeKey="automations"
  title="Automatización de procesos con IA para pymes"
  description="Automatización de procesos para pymes de Lleida y de toda España. Conecta herramientas y reduce tareas manuales con IA cuando aporta valor."
>
  <PageHero
    locale={locale}
    eyebrow="AUTOMATIZACIONES"
    title="Automatización de procesos para reducir trabajo manual"
    lede="Conectamos las herramientas que ya utilizas para clasificar documentos, extraer datos y agilizar comunicaciones. Aplicamos IA cuando aporta valor, con revisión humana de los casos que la necesitan."
    crumb={{ name: 'Automatizaciones', path: route('automations', locale) }}
    primaryLabel="Cuéntanos tu caso"
    primaryHref="#parlem"
  />

  <section class="section">
    <div class="container narrow">
      <SectionHeader eyebrow="EL PRINCIPIO" title="No todo se debe automatizar" as="h2" />
      <p>
        Hay negocios que llegan pidiendo "quiero automatizarlo todo" y, al mirarlo de cerca,
        el problema real es otro: un proceso mal definido, información que no se documenta
        en ningún sitio, o una tarea que solo pasa dos veces al mes y no vale la pena construir
        nada para ella. Automatizar algo que no funciona bien solo hace que falle más rápido.
      </p>
      <p>
        Por eso, antes de proponer cualquier automatización, miramos tres cosas: cuánto tiempo
        se pierde realmente, qué riesgo de error hay si sigue haciéndose a mano, y cuánto
        costaría (en tiempo y dinero) construirlo bien. Si los números no salen, te lo decimos
        — aunque quieras pagarlo.
      </p>
    </div>
  </section>

  <SolutionCatalog locale={locale} anchor="solucions" />

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="ANTES Y DESPUÉS" title="Dos ejemplos habituales" lede="Situaciones típicas, no casos reales de un cliente concreto — todavía no tenemos publicados." />
      <div class="ba-stack">
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="Cada pedido o consulta que llega por WhatsApp se apunta a mano en una libreta o Excel, y de vez en cuando se pierde alguno."
          after="Los pedidos se registran solos al llegar, con confirmación automática al cliente y aviso inmediato para quien los tiene que preparar."
        />
        <BeforeAfterRow
          beforeLabel="Antes"
          afterLabel="Después"
          before="Cada mes alguien dedica un par de horas a copiar datos de facturas a un Excel para el informe trimestral."
          after="Los datos se extraen solos de cada factura y el informe se genera automáticamente, listo para revisar."
        />
      </div>
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader eyebrow="PRECIOS" title="Precios orientativos" />
      <PriceStrip
        locale={locale}
        items={[
          { label: 'Automatización puntual', band: SERVICE_PRICING.automation, note: 'Un proceso concreto, bien delimitado.' },
          { label: 'Proyectos avanzados', band: SERVICE_PRICING.automationAdvanced, note: 'Varias automatizaciones conectadas entre sí.' },
          { label: 'Software a medida', band: SERVICE_PRICING.customSoftware, note: 'Cuando hay que construir algo desde cero.' },
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="PREGUNTAS" title="Preguntas frecuentes" />
      <FaqAccordion
        items={[
          { q: '¿Cómo sé si mi proceso vale la pena automatizarlo?', a: 'Si lo haces más de diez veces al mes, si es propenso a errores humanos, o si depende de que alguien se acuerde, normalmente vale la pena mirarlo. Si pasa una vez al mes, probablemente no.' },
          { q: '¿Necesito cambiar las herramientas que ya uso?', a: 'Normalmente no. Solemos conectar las herramientas que ya tienes antes de proponerte otras nuevas.' },
          { q: '¿Cuánto tarda en estar en marcha?', a: 'Una automatización puntual suele tardar entre 1 y 3 semanas desde que se define el alcance. Los proyectos avanzados dependen del número de procesos implicados.' },
          { q: '¿Qué pasa si cambia el proceso más adelante?', a: 'Lo hablamos cuando llegue el momento. Siempre documentamos cómo funciona lo que construimos para poder ajustarlo sin empezar de cero.' },
        ]}
      />
    </div>
  </section>

  <EnquirySection locale={locale} interest="automations" />

  <ServiceSchema
    name="Automatizaciones"
    description="Automatización de procesos, documentos, mensajes y tareas repetitivas para pymes y autónomos."
    path={route('automations', locale)}
  />
</BaseLayout>

<style>
  .narrow { max-width: 760px; }
  .bg-alt { background: var(--gray-50); }
  .ba-stack { display: flex; flex-direction: column; gap: var(--space-3); }
</style>
