---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import SolutionCatalog from '@/components/SolutionCatalog.astro';
import { route } from '@/i18n/routes';

const locale = 'ca' as const;
---
<BaseLayout
  locale={locale}
  routeKey="services"
  title="Serveis d’IA i automatització per a pimes"
  description="Assistents amb documents, WhatsApp, cites, informes i aplicacions amb IA. Troba la solució per al teu negoci i consulta’n l’abast i els preus orientatius."
>
  <PageHero
    locale={locale}
    eyebrow="SERVEIS"
    title="Solucions d’IA per a la feina del teu negoci"
    lede="Comença per una necessitat concreta: documents, consultes, cites o dades. Podem estudiar el procés amb una consultoria, implementar una solució a mida o formar el teu equip."
    crumb={{ name: 'Serveis', path: route('services', locale) }}
  />

  <section class="section">
    <div class="container">
      <div class="grid-4">
        <ServiceCard headingLevel="h2"
          icon="automation"
          title="Automatitzacions"
          description="Processos, documents i tasques repetitives que passen a fer-se soles."
          href={route('automations', locale)}
          linkLabel="Veure automatitzacions"
        />
        <ServiceCard headingLevel="h2"
          icon="consulting"
          title="Consultoria"
          description="Un diagnòstic d’oportunitats d’IA i automatització, amb prioritats i un full de ruta."
          href={route('consulting', locale)}
          linkLabel="Veure consultoria"
        />
        <ServiceCard headingLevel="h2"
          icon="training"
          title="Formació"
          description="Perquè el teu equip aprengui a treure profit real de la IA en el dia a dia."
          href={route('training', locale)}
          linkLabel="Veure formació"
        />
        <ServiceCard headingLevel="h2"
          icon="invoicing"
          title="VBG Facturació"
          description="El nostre producte propi per gestionar factures rebudes, amb IA integrada."
          href={route('invoicing', locale)}
          linkLabel="Veure el producte"
          accent
        />
      </div>
    </div>
  </section>

  <SolutionCatalog locale={locale} anchor="solucions" />
  <SolutionCatalog locale={locale} kind="sector" anchor="sectors" />

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader
        eyebrow="COM TRIAR"
        title="Si no ho tens clar, comença per una consultoria"
        lede="Una consultoria breu (350–650€ + IVA) et dona un diagnòstic i un full de ruta prioritzat abans de gastar res en implementació. A partir d'aquí decideixes si vols que ho construïm nosaltres."
      />
    </div>
  </section>

  <CtaBand
    locale={locale}
    title="No saps per on començar?"
    lede="Explica'ns el teu cas en 15 minuts i et diem, sense compromís, per on començaríem nosaltres."
    primaryLabel="Explica'ns el teu cas"
  />
</BaseLayout>

<style>
  .grid-4 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .grid-4 {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1080px) {
    .grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
