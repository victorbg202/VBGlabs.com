---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import ProductFrame from '@/components/ProductFrame.astro';
import InvoicingPanels from '@/components/InvoicingPanels.astro';
import PricingPlans from '@/components/PricingPlans.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EnquirySection from '@/components/EnquirySection.astro';
import SoftwareApplicationSchema from '@/components/schema/SoftwareApplicationSchema.astro';
import AssistantDemo from '@/components/AssistantDemo.astro';
import ProductTabs from '@/components/ProductTabs.astro';
import { route } from '@/i18n/routes';
import { CONTACT_COPY } from '@/data/enquiries';

const locale = 'ca' as const;

const panelLabels = {
  thisMonth: 'Factures aquest mes', correct: 'Correctes', pending: 'Pendents revisió',
  supplier: 'Proveïdor', amount: 'Import', status: 'A revisar', okStatus: 'Correcta',
  reviewTitle: 'Possible duplicat detectat', reviewNote: 'Mateix proveïdor i import que una factura ja registrada.',
  reportTitle: 'Resum fiscal del trimestre', vat: 'IVA suportat', withholding: 'IRPF retingut',
};

const narrative = [
  {
    variant: 'invoices' as const,
    tag: 'Rebre i organitzar',
    title: 'Cada factura que reps, registrada sola',
    body: 'Arriba per correu, se t’envia o la puges tu mateix: VBG Facturació la llegeix, n’extreu les dades i la deixa organitzada. Res es queda perdut en una safata d’entrada.',
  },
  {
    variant: 'review' as const,
    tag: 'Revisar',
    title: 'El sistema avisa; tu decideixes',
    body: 'Detecta possibles duplicats i incidències abans que arribin a pagament. Tu només revises el que realment necessita una decisió humana.',
  },
  {
    variant: 'dashboard' as const,
    tag: 'Veure-ho tot',
    title: 'Un panell amb l’estat real del mes',
    body: 'Quantes factures hi ha, quantes estan correctes, quantes esperen revisió i quant hi ha pendent de pagar — d’un cop d’ull, sense obrir cap full de càlcul.',
  },
  {
    variant: 'reports' as const,
    tag: 'Presentar',
    title: 'Informes fiscals llestos per presentar',
    body: 'IVA suportat, IRPF retingut i el desglossament trimestral, generats automàticament a partir de les factures ja registrades.',
  },
];
---
<BaseLayout
  locale={locale}
  routeKey="invoicing"
  title="VBG Facturació: gestió de factures rebudes amb IA"
  description="Gestiona factures de proveïdors amb VBG Facturació: extracció de dades amb IA, revisió de duplicats i documents organitzats. Sol·licita una demo."
>
  <section class="hero">
    <div class="container">
      <Breadcrumb locale={locale} trail={[{ name: 'VBG Facturació', path: route('invoicing', locale) }]} />
      <div class="hero__grid">
        <div>
          <p class="eyebrow">PRODUCTE PROPI DE VBG LABS</p>
          <h1>Gestiona les factures rebudes amb IA</h1>
          <p class="lede">
            VBG Facturació llegeix les factures dels teus proveïdors, n’extreu les dades i les organitza en un sol panell. Revisa possibles duplicats i consulta la informació amb un assistent d’IA.
          </p>
          <div class="hero__actions">
            <a href="#parlem" class="btn btn-primary">Sol·licita una demo</a>
            <a href="#preus" class="btn btn-outline">Veure preus</a>
          </div>
          <p class="demo-response">{CONTACT_COPY[locale].response} {CONTACT_COPY[locale].enquiries.invoicing.body}</p>
        </div>
        <ProductFrame label="facturacion.vbglabs.com">
          <InvoicingPanels variant="dashboard" labels={panelLabels} />
        </ProductFrame>
      </div>
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container narrow">
      <SectionHeader eyebrow="QUÈ FA (I QUÈ NO FA)" title="Gestiona les factures que reps, no les que emets" as="h2" />
      <p>
        VBG Facturació se centra en un problema concret: les factures que arriben al teu
        negoci des de proveïdors i col·laboradors. Les centralitza, les revisa i et deixa els
        informes fiscals a punt. Ara mateix <strong>no emet factures de venda</strong> als teus
        clients — si necessites això, seguiràs fent-ho amb el que ja facis servir, i VBG
        Facturació s&#39;encarrega de la part de les factures rebudes.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProductTabs
        items={narrative}
        frameLabel="facturacion.vbglabs.com"
        tablistLabel="Funcions de VBG Facturació"
        panelLabels={panelLabels}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader eyebrow="ASSISTENT IA" title="Pregunta-li directament a les teves factures" lede="Un assistent integrat que respon sobre les teves factures en llenguatge natural, sense haver de buscar manualment." />
      <AssistantDemo
        userMsg="Quant IVA he suportat aquest trimestre?"
        botMsg="Aquest trimestre has suportat 2.481,00€ d'IVA en 34 factures. Vols el desglossament per proveïdor?"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="PER A QUI" title="Pensat per a qui gestiona factures cada mes" />
      <FeatureGrid
        columns={4}
        items={[
          { icon: 'users', title: 'Autònoms', description: 'Deixa d\'apilar tiquets i factures a l\'espera de fer-hi alguna cosa.' },
          { icon: 'building', title: 'Micropimes', description: 'Centralitza les factures de tots els proveïdors en un sol lloc.' },
          { icon: 'chart', title: 'Pimes', description: 'Informes fiscals a punt sense dependre d\'un full de càlcul.' },
          { icon: 'consulting', title: 'Gestories i grups', description: 'Gestió de diversos clients o societats des d’un mateix accés, amb dades separades per empresa.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt" id="preus">
    <div class="container">
      <SectionHeader eyebrow="PREUS" title="Plans senzills, sense sorpreses" lede="Tria segons el volum de documents, l’equip i el nombre d’empreses. Preus orientatius, sense permanència." />
      <PricingPlans locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="PREGUNTES" title="Preguntes freqüents" />
      <FaqAccordion
        items={[
          { q: 'VBG Facturació emet factures als meus clients?', a: 'No, ara mateix no. Es centra exclusivament a gestionar les factures que reps de proveïdors i col·laboradors.' },
          { q: 'On es guarden les meves dades?', a: 'Les factures i les dades associades es guarden de manera privada, associades només al teu compte. No compartim dades entre comptes de clients diferents.' },
          { q: 'Puc provar-ho abans de contractar-ho?', a: 'Sí. Sol·licita una demo i et l\'ensenyem amb el teu cas real abans de decidir.' },
          { q: 'Com es compten els documents del pla?', a: 'Una factura processada compta com un document i un albarà com un altre. A Pro i Business la quota és per empresa; al pla Gestories i grups empresarials es comparteix entre les empreses incloses. Visualitzar o descarregar un document no consumeix una nova lectura.' },
          { q: 'Què passa si necessito més volum o més usuaris?', a: 'Abans de contractar concretem el volum i els usuaris inclosos. Si les necessitats canvien, pressupostem una ampliació o un canvi de pla. Les ampliacions no estan incloses en el preu publicat.' },
          { q: 'El xat d’IA és il·limitat?', a: 'No. Tots els plans inclouen l’assistent amb un crèdit mensual que es concreta a l’oferta abans de l’alta i es pot consultar al panell. Les ampliacions se sol·liciten a part. Arribar al topall del xat no atura el processament de factures.' },
          { q: 'Serveix per a gestories i grups empresarials?', a: 'Sí. El pla Gestories i grups empresarials parteix de 5 empreses, 10 usuaris en total i 1.000 documents mensuals compartits. Cada empresa manté les seves factures, proveïdors i informes. Per a més societats o volum, preparem una oferta a mida.' },
          { q: 'Què inclou la posada en marxa?', a: 'Business i el pla multiempresa inclouen una sessió inicial per configurar el circuit de treball. La importació d’històrics, les integracions especials i la formació addicional es pressuposten a part. Els informes són preparatoris i no inclouen la presentació d’impostos ni el servei de gestoria.' },
        ]}
      />
    </div>
  </section>

  <EnquirySection locale={locale} interest="invoicing" />

  <SoftwareApplicationSchema locale={locale} />
</BaseLayout>

<style>
  .hero__grid > :global(*) { min-width: 0; }
  .demo-response { font-size:var(--text-sm); color:var(--muted); margin-top:var(--space-3); max-width:60ch; }
  .hero {
    padding-block: var(--space-4) var(--space-7);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    margin-top: var(--space-3);
  }

  @media (min-width: 940px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero h1 {
    font-size: var(--text-3xl);
    margin-block: var(--space-2);
  }

  .hero .lede {
    font-size: var(--text-md);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .narrow {
    max-width: 760px;
  }

  .bg-alt {
    background: var(--gray-50);
  }


</style>
