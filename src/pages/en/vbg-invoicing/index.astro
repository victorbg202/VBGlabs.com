---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import ProductFrame from '@/components/ProductFrame.astro';
import InvoicingPanels from '@/components/InvoicingPanels.astro';
import PricingPlans from '@/components/PricingPlans.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import EnquirySection from '@/components/EnquirySection.astro';
import SoftwareApplicationSchema from '@/components/schema/SoftwareApplicationSchema.astro';
import AssistantDemo from '@/components/AssistantDemo.astro';
import ProductTabs from '@/components/ProductTabs.astro';
import { route } from '@/i18n/routes';
import { CONTACT_COPY } from '@/data/enquiries';

const locale = 'en' as const;

const panelLabels = {
  thisMonth: 'Invoices this month', correct: 'Correct', pending: 'Pending review',
  supplier: 'Supplier', amount: 'Amount', status: 'To review', okStatus: 'Correct',
  reviewTitle: 'Possible duplicate detected', reviewNote: 'Same supplier and amount as an invoice already on file.',
  reportTitle: "This quarter's tax summary", vat: 'VAT paid', withholding: 'Withholding tax',
};

const narrative = [
  { variant: 'invoices' as const, tag: 'Receive and organize', title: 'Every invoice you receive, registered on its own', body: "It arrives by email, gets sent to you, or you upload it yourself: VBG Invoicing reads it, pulls out the data, and files it. Nothing gets lost in an inbox." },
  { variant: 'review' as const, tag: 'Review', title: 'The system flags it; you decide', body: 'It catches possible duplicates and exceptions before they reach payment. You only review what genuinely needs a human call.' },
  { variant: 'dashboard' as const, tag: 'See it all', title: "A dashboard with this month's real status", body: 'How many invoices there are, how many are correct, how many are waiting on review, and how much is still due — at a glance, no spreadsheet required.' },
  { variant: 'reports' as const, tag: 'File', title: 'Tax reports ready to file', body: 'VAT paid, withholding tax and the quarterly breakdown, generated automatically from the invoices already on file.' },
];
---
<BaseLayout
  locale={locale}
  routeKey="invoicing"
  title="VBG Invoicing: AI supplier invoice management"
  description="Manage supplier invoices with VBG Invoicing: AI data extraction, duplicate checks and organised documents in one dashboard. Request a demo."
>
  <section class="hero">
    <div class="container">
      <Breadcrumb locale={locale} trail={[{ name: 'VBG Invoicing', path: route('invoicing', locale) }]} />
      <div class="hero__grid">
        <div>
          <p class="eyebrow">A VBG LABS PRODUCT</p>
          <h1>Manage supplier invoices with AI</h1>
          <p class="lede">
            VBG Invoicing reads your supplier invoices, extracts their data and organises them in one dashboard. Review possible duplicates and find information with a built-in AI assistant.
          </p>
          <div class="hero__actions">
            <a href="#parlem" class="btn btn-primary">Request a demo</a>
            <a href="#pricing" class="btn btn-outline">See pricing</a>
          </div>
          <p class="demo-response">{CONTACT_COPY[locale].response} {CONTACT_COPY[locale].enquiries.invoicing.body}</p>
        </div>
        <ProductFrame label="facturacion.vbglabs.com">
          <InvoicingPanels variant="dashboard" labels={panelLabels} />
        </ProductFrame>
      </div>
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container narrow">
      <SectionHeader eyebrow="WHAT IT DOES (AND DOESN'T)" title="It manages the invoices you receive, not the ones you issue" as="h2" />
      <p>
        VBG Invoicing focuses on one specific problem: the invoices coming into your business
        from suppliers and contractors. It centralizes them, reviews them, and gets your tax
        reports ready. Right now it <strong>doesn't issue sales invoices</strong> to your own
        customers — you'll keep doing that with whatever you already use, while VBG Invoicing
        handles the received side.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProductTabs
        items={narrative}
        frameLabel="facturacion.vbglabs.com"
        tablistLabel="VBG Invoicing features"
        panelLabels={panelLabels}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container">
      <SectionHeader eyebrow="AI ASSISTANT" title="Ask your invoices directly" lede="A built-in assistant that answers questions about your invoices in plain language, no manual searching." />
      <AssistantDemo
        userMsg="How much VAT have I paid this quarter?"
        botMsg="You've paid €2,481.00 in VAT across 34 invoices this quarter. Want the breakdown by supplier?"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="WHO IT'S FOR" title="Built for anyone handling invoices every month" />
      <FeatureGrid
        columns={4}
        items={[
          { icon: 'users', title: 'Freelancers', description: "Stop piling up receipts and invoices to deal with later." },
          { icon: 'building', title: 'Micro-businesses', description: 'Centralize invoices from every supplier in one place.' },
          { icon: 'chart', title: 'SMEs', description: 'Tax reports ready to go, no spreadsheet required.' },
          { icon: 'consulting', title: 'Firms and groups', description: 'Manage clients or group companies from one sign-in, with separate records for each company.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt" id="pricing">
    <div class="container">
      <SectionHeader eyebrow="PRICING" title="Simple plans, no surprises" lede="Choose by document volume, team size and number of companies. Indicative pricing, no minimum term." />
      <PricingPlans locale={locale} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="QUESTIONS" title="Frequently asked questions" />
      <FaqAccordion
        items={[
          { q: 'Does VBG Invoicing issue invoices to my customers?', a: "Not right now. It's focused solely on managing the invoices you receive from suppliers and contractors." },
          { q: 'Where is my data stored?', a: 'Invoices and related data are stored privately, tied only to your account. We never share data between different customer accounts.' },
          { q: 'Can I try it before committing?', a: "Yes. Request a demo and we'll walk through it with your real case before you decide." },
          { q: 'How are documents counted?', a: 'Each processed invoice counts as one document, and each delivery note as another. Pro and Business allowances apply to one company; the Accounting firms & business groups allowance is shared across the included companies. Viewing or downloading a document does not use another scan.' },
          { q: 'What if I need more volume or more users?', a: 'We agree the included volume and users before signup. If your needs change, we quote an allowance extension or a plan change. Extensions are not included in the published price.' },
          { q: 'Is the AI chat unlimited?', a: 'No. All plans include the assistant with a monthly credit allowance agreed in your offer before signup and visible in the dashboard. Extra credit is requested separately. Reaching the chat limit does not stop invoice processing.' },
          { q: 'Does it work for accounting firms and business groups?', a: 'Yes. The Accounting firms & business groups plan starts with 5 companies, 10 users in total and 1,000 shared documents per month. Each company keeps separate invoices, suppliers and reports. We provide a custom quote for more companies or volume.' },
          { q: 'What does onboarding include?', a: 'Business and the multi-company plan include an initial session to set up the workflow. Historical imports, special integrations and additional training are quoted separately. Reports are preparatory; tax filing and accounting services are not included.' },
        ]}
      />
    </div>
  </section>

  <EnquirySection locale={locale} interest="invoicing" />

  <SoftwareApplicationSchema locale={locale} />
</BaseLayout>

<style>
  .hero__grid > :global(*) { min-width: 0; }
  .demo-response { font-size:var(--text-sm); color:var(--muted); margin-top:var(--space-3); max-width:60ch; }
  .hero { padding-block: var(--space-4) var(--space-7); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); align-items: center; margin-top: var(--space-3); }
  @media (min-width: 940px) { .hero__grid { grid-template-columns: 1.1fr 0.9fr; } }
  .hero h1 { font-size: var(--text-3xl); margin-block: var(--space-2); }
  .hero .lede { font-size: var(--text-md); max-width: 48ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .narrow { max-width: 760px; }
  .bg-alt { background: var(--gray-50); }
</style>
