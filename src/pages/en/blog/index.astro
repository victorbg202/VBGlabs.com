---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import BlogCard from '@/components/BlogCard.astro';
import { route } from '@/i18n/routes';
import { getCollection } from 'astro:content';

const locale = 'en' as const;
const posts = (await getCollection('blog', (p) => p.data.lang === locale && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  locale={locale}
  routeKey="blog"
  title="Blog — Automation and applied AI, no filler"
  description="Practical articles about automation, applied AI and running a business, for small and medium companies."
>
  <PageHero
    locale={locale}
    eyebrow="BLOG"
    title="Worth a closer look"
    lede="Practical articles, no filler, about automation and applied AI for real businesses."
    crumb={{ name: 'Blog', path: route('blog', locale) }}
  />
  <section class="section">
    <div class="container">
      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => (
            <BlogCard headingLevel="h2"
              href={`${route('blog', locale)}${post.data.slug}/`}
              category={post.data.category}
              title={post.data.title}
              description={post.data.description}
              date={dateFmt.format(post.data.date)}
              readLabel="Read"
            />
          ))}
        </div>
      ) : (
        <p>No articles published yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
