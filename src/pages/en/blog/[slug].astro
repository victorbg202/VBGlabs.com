---
import BlogPostLayout from '@/components/BlogPostLayout.astro';
import { getCollection } from 'astro:content';
import { route } from '@/i18n/routes';
import type { Locale } from '@/i18n/locales';

const locale = 'en' as const;

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'en' && !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;

const allPosts = await getCollection('blog', (p) => !p.data.draft);
const translations = allPosts.filter((p) => p.data.translationGroup === entry.data.translationGroup);
const alternates: { locale: Locale; path: string }[] = translations.map((p) => ({
  locale: p.data.lang,
  path: `${route('blog', p.data.lang)}${p.data.slug}/`,
}));

const related = allPosts
  .filter((p) => p.data.lang === locale && p.id !== entry.id && entry.data.relatedSlugs.includes(p.data.slug))
  .slice(0, 2);
---
<BlogPostLayout
  locale={locale}
  entry={entry}
  alternates={alternates}
  related={related}
  ctaTitle="Let's talk about your business"
  ctaLede="No obligation. In 15-20 minutes we'll know if we can help."
  ctaLabel="Tell us your case"
  readLabel="Read"
  relatedTitle="You might also like"
/>
