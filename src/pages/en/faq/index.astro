---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import { route } from '@/i18n/routes';

const locale = 'en' as const;
---
<BaseLayout
  locale={locale}
  routeKey="faq"
  title="Frequently asked questions"
  description="Answers to the most common questions about how VBG Labs works, indicative pricing, and how we handle data."
>
  <PageHero
    locale={locale}
    eyebrow="FREQUENTLY ASKED QUESTIONS"
    title="Common questions, straight answers"
    lede="Can't find what you're looking for? Get in touch directly — we reply within 2 business days."
    crumb={{ name: 'FAQ', path: route('faq', locale) }}
  />

  <section class="section">
    <div class="container narrow">
      <SectionHeader eyebrow="GENERAL" title="About VBG Labs" as="h2" />
      <FaqAccordion
        items={[
          { q: 'Who are you and where are you based?', a: "We're VBG Labs, a technology consultancy based in Catalonia, Spain. We work with businesses across Spain and beyond, in person or remote." },
          { q: 'Do I need to know about AI or tech to work with you?', a: 'No. We speak your language, not ours. We handle the technical side.' },
          { q: 'What languages do you work in?', a: 'Catalan, Spanish and English, both in day-to-day communication and in the documents we deliver.' },
          { q: 'Do you only work with large companies?', a: 'No, quite the opposite: we mostly work with small and medium businesses. That\'s our core audience.' },
        ]}
      />
    </div>
  </section>

  <section class="section section--tight bg-alt">
    <div class="container narrow">
      <SectionHeader eyebrow="SERVICES AND PRICING" title="How we work, and what it costs" as="h2" />
      <FaqAccordion
        items={[
          { q: 'Where should I start?', a: "If you're not sure, start with consulting (350–650€ + VAT). It gives you a diagnosis and a roadmap before you spend anything on implementation." },
          { q: 'Are the prices you publish final?', a: "They're indicative, to give you a sense of scale. The final quote depends on the specific scope of your case, and we always confirm it in writing before starting." },
          { q: 'Do you always end up recommending automating everything?', a: 'No. Sometimes the best advice is to leave things alone, or just tidy up what you already have.' },
          { q: 'How long does a typical project take?', a: 'A one-off automation usually takes 1-3 weeks. Consulting, 1-2 weeks. Custom software projects are scoped case by case within the roadmap.' },
          { q: 'Do you offer ongoing support after implementation?', a: 'Yes, as optional ongoing support, from 120€/mo + VAT.' },
        ]}
      />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <SectionHeader eyebrow="DATA AND PRIVACY" title="How we handle information" as="h2" />
      <FaqAccordion
        items={[
          { q: "What happens to my business's data?", a: "It's used exclusively for the project you shared it for, and never shared with third parties without your consent. More detail in our privacy policy." },
          { q: 'Does VBG Invoicing share data between customers?', a: "No. Every account is independent — one customer's data is never visible to another." },
          { q: 'Can I ask you to delete my data?', a: 'Yes, at any time. Email info@vbglabs.com with the subject "Data rights request".' },
        ]}
      />
    </div>
  </section>

  <CtaBand locale={locale} variant="dark" title="Didn't find your answer?" lede="Get in touch and we'll sort it out directly." primaryLabel="Tell us your case" />
</BaseLayout>

<style>
  .narrow { max-width: 760px; }
  .bg-alt { background: var(--gray-50); }
</style>
